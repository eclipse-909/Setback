# See tracing-subscriber crate - https://docs.rs/tracing-subscriber/latest/tracing_subscriber/
RUST_LOG=info

# 'json' or 'pretty'
LOG_FORMAT=json

# api
# use your email host, user, & password here
#SETBACK_NO_REPLY_EMAIL_HOST=smtp.gmail.com
#SETBACK_NO_REPLY_EMAIL_USER=example@gmail.com
#SETBACK_NO_REPLY_EMAIL_PASS=abcdefghijklmnop

# You shouldn't need to touch any of the below variables
# unless you're trying to connect your locally running instance to dev.

# docker compose
MYSQL_ROOT_PASSWORD=1234
MYSQL_DATABASE=setback-db

# api
DATABASE_URL="mysql://root:${MYSQL_ROOT_PASSWORD}@127.0.0.1:3306/${MYSQL_DATABASE}"
API_JWT_SECRET=1234
API_BIND_ADDR=0.0.0.0:8000

# server
SERVER_BIND_ADDR=0.0.0.0:42070
API_KEY=1234
API_BASE_URL=http://127.0.0.1:8000

# client
SETBACK_HOST=localhost
PUBLIC_API_URL="https://${SETBACK_HOST}"
PUBLIC_WS_URL="wss://${SETBACK_HOST}:42069"