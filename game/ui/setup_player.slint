import {BaseText} from "base_text.slint";
import {StylizedCheckbox} from "stylized_checkbox.slint";
import {StylizedSpinBox} from "stylized_spin_box.slint";
import {Palette} from "global.slint";

export component SetupPlayer inherits HorizontalLayout {
	in property <string> username;
	in property <bool> human;
	in property <int> team;
	in property <bool> human_enabled;
	in property <bool> team_enabled;
	in property <bool> can_drag;
	in property <bool> ready;
	in property <bool> show_ready;
	in property <bool> can_remove;
	in property <int> index;
	private property <bool> is_dragging;
	private property <length> drag_offset_x;
	private property <length> drag_offset_y;
	private property <length> og_x;
	private property <length> og_y;
	private property <duration> animation_duration: 300ms;

	callback remove;
	callback toggle_human(human: bool);
	callback team_changed(team: int);

	animate x, y { duration: animation_duration; easing: ease; }

	init => {
		root.og_x = root.x;
		root.og_y = root.y;
	}

	height: 175px;

	touchArea := TouchArea {
		width: root.height;
		height: root.height;
		enabled: root.can_drag;

		Image {
			width: root.height;
			height: root.height;
			source: root.human ? @image-url("../assets/images/personIcon.png") : @image-url("../assets/images/botIcon.png");
			colorize: Palette.Orange;
			image-fit: contain;
		}

		pointer-event(event) => {
			if (event.kind == PointerEventKind.down && !root.is_dragging && event.button == PointerEventButton.left) {
				root.animation_duration = 0ms;
				root.drag_offset_x = root.x - (self.absolute-position.x + self.mouse-x);
				root.drag_offset_y = root.y - (self.absolute-position.y + self.mouse-y);
				root.is_dragging = true;
			} else if (event.kind == PointerEventKind.up && root.is_dragging && event.button == PointerEventButton.left) {
				root.animation_duration = 300ms;
				root.is_dragging = false;
				root.x = root.og_x;
				root.y = root.og_y;
			} else if (event.kind == PointerEventKind.move && root.is_dragging) {
				root.x = self.absolute-position.x + self.mouse-x + root.drag_offset_x;
				root.y = self.absolute-position.y + self.mouse-y + root.drag_offset_y;
			}
			// if (event.kind == PointerEventKind.move && !root.is_dragging) {
			// 	debug("moving player", root.index);
			// }
		}

		states [
			pressed when self.pressed && root.can_drag: {
				touchArea.mouse-cursor: grabbing;
			}
			hover when self.has-hover && root.can_drag: {
				touchArea.mouse-cursor: grab;
			}
		]
	}

	VerticalLayout {
		alignment: start;
		spacing: 10px;

		xBG := Rectangle {
			background: #18181840;
			width: 30px;
			height: 30px;
			border-width: 4px;
			border-color: Palette.Orange;
			border-radius: 10px;
			visible: root.can_remove;

			xTouchArea := TouchArea {
				width: 30px;
				height: 30px;
				enabled: root.can_remove;

				checkmark := Image {
					source: @image-url("../assets/images/x.png");
					image-fit: contain;
					width: 18px;
					height: 18px;
				}

				clicked => {root.remove();}
			}

			animate background { duration: 32ms; }

			states [
				hover when xTouchArea.has-hover: {
					xBG.background: #18181880;
					xTouchArea.mouse-cursor: pointer;
				}
				pressed when xTouchArea.pressed: {
					xBG.background: #181818c0;
					xTouchArea.mouse-cursor: pointer;
				}
			]
		}
		BaseText {
			text: username;
			font-size: 20px;
		}
		if human_enabled: StylizedCheckbox {
			text: "Human";
			enabled: human;

			toggled(value) => {root.toggle_human(value);}
		}
		VerticalLayout {
			BaseText {
				text: "Team Number:";
				font-size: 20px;
			}
			if team_enabled: StylizedSpinBox {
				value: team;
				minimum: 0;
				maximum: 7;
				height: 25px;
				width: 25px;

				changed(value) => {root.team_changed(value);}
			}
		}
		if root.show_ready: BaseText {
			text: root.ready ? "Ready" : "Not Ready";
			font-size: 20px;
		}
	}
}