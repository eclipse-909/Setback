import {StandardButton} from "std-widgets.slint";

// game/ui/components.slint

export global Palette {
	out property <color> Green: #04F06A;
	out property <color> Blue: #2F52E0;
	out property <color> Yellow: #F9CB40;
	out property <color> Orange: #FF715B;
	out property <color> Gray: #4C5B5C;
}

// Base text style used throughout the app
export component BaseText {
    in property <string> text;
    in property <length> font-size: 16px;
	in property <bool> bold: false;
    in property <int> font-weight: root.bold ? 900 : 400;
    in property <TextHorizontalAlignment> horizontal-alignment: TextHorizontalAlignment.left;
    in property <TextVerticalAlignment> vertical-alignment: TextVerticalAlignment.top;
    in property <bool> wrap: false;

    Text {
        text: root.text;
        font-size: root.font-size;
        font-weight: root.font-weight;
        color: Palette.Orange;
        stroke: Palette.Gray;
        stroke-width: root.font-size / 20px * 1px;
        horizontal-alignment: root.horizontal-alignment;
        vertical-alignment: root.vertical-alignment;
        wrap: root.wrap ? TextWrap.word-wrap : TextWrap.no-wrap;
        width: root.width;
        height: root.height;
    }
}

// Enhanced version of your existing MenuButton with more customization
export component StylizedButton {
    in property <string> text;
    in property <length> font-size: 16px;
	width: 450px;
	height: font-size * 2;
    in property <bool> enabled: true;
    callback clicked;

    Rectangle {
        width: root.width;
        height: root.height;
        background: root.enabled ? #18181840 : #18181820;
        border-radius: root.height / 4;
        border-width: 2px;
        border-color: root.enabled ? Palette.Orange : Palette.Orange.darker(0.3);

        touchArea := TouchArea {
            enabled: root.enabled;
            width: 100%;
            height: 100%;

            clicked => {
                if (root.enabled) { root.clicked(); }
            }

            BaseText {
                text: root.text;
                font-size: root.font-size;
                bold: true;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        animate background { duration: 100ms; }
        animate border-color { duration: 100ms; }

        states [
            pressed when root.enabled && touchArea.pressed: {
                background: #18181880;
                border-color: Palette.Orange.darker(0.2);
            }
            hover when root.enabled && touchArea.has-hover: {
                background: #18181860;
                touchArea.mouse-cursor: pointer;
            }
        ]
    }
}

// Enhanced checkbox with animation and custom styling
export component StylizedCheckbox {
    in property <string> text;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    in property <length> size: 24px;
    callback toggled(bool);

    HorizontalLayout {
        spacing: size / 2;
        alignment: start;

        Rectangle {
            width: root.size;
            height: root.size;
            background: root.enabled ? #18181840 : #18181820;
            border-radius: size / 4;
            border-width: 2px;
            border-color: root.enabled ? Palette.Orange : Palette.Orange.darker(0.3);

            touchArea := TouchArea {
                enabled: root.enabled;
                clicked => {
                    if (root.enabled) {
                        root.checked = !root.checked;
                        root.toggled(root.checked);
                    }
                }
            }

            Image {
                visible: root.checked;
                source: @image-url("../assets/images/checkmark.png");
                width: parent.width * 0.8;
                height: parent.height * 0.8;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            animate background { duration: 100ms; }
            animate border-color { duration: 100ms; }

            states [
                pressed when root.enabled && touchArea.pressed: {
                    background: #18181880;
                    border-color: Palette.Orange.darker(0.2);
                }
                hover when root.enabled && touchArea.has-hover: {
                    background: #18181860;
                    touchArea.mouse-cursor: pointer;
                }
            ]
        }

        BaseText {
            text: root.text;
            font-size: root.size;
            vertical-alignment: center;
        }
    }
}

// Custom slider with better visual feedback
export component StylizedSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in-out property <float> value;
	in property <bool> enabled: true;

	callback changed(value: float);

    width: 200px;
	height: 24px;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    border-radius: root.height/2;
    background: touch.pressed ? #eee: #ddd;
    border-width: 1px;
    border-color: root.background.darker(25%);

    handle := Rectangle {
        width: self.height;
        height: parent.height;
        border-width: 3px;
        border-radius: self.height / 2;
        background: touch.pressed ? Palette.Orange.darker(0.2) : Palette.Orange;
        border-color: self.background.darker(15%);
        x: (root.width - handle.width) * (root.value - root.minimum)/(root.maximum - root.minimum);

        touch := TouchArea {
            moved => {
                if (self.enabled && self.pressed) {
                    root.value = round(max(root.minimum, min(root.maximum, root.value + (self.mouse-x - self.pressed-x) * (root.maximum - root.minimum) / root.width)) / root.step) * root.step;
					root.changed(root.value);
                }
            }
        }
    }
}

export component StylizedComboBox inherits Rectangle {
    in-out property <string> value;
    in property <[string]> choices;
	in property <bool> enabled <=> button.enabled;

	callback selected(choice: string);

    border-radius: 3px;
    border-width: 2px;
    border-color: Palette.Orange;
    height: 32px;
    min-width: label.x + label.width + i.width;
    horizontal-stretch: 1;

    label := BaseText {
		vertical-alignment: center;
        horizontal-alignment: left;
        text <=> root.value;
        height: 100%;
        x: 12px;
		font-size: root.height * 0.6;
	}

    i := Image {
        source: @image-url("../assets/images/dropdown-arrow.png");
        colorize: Palette.Orange;
        height: 40%;
        width: self.height;
        image-fit: contain;
        x: parent.width - self.width - self.y;
        y: (parent.height - self.height)/2;
    }

    button :=TouchArea {
        clicked => { popup.show(); }

        width: 100%;
        height: 100%;
    }

    popup := PopupWindow {
        x:0;
        y: root.height;
        width: root.width;

        Rectangle {
            background: #181818e0;
            border-radius: 3px;
            border-width: 2px;
            border-color: Palette.Orange;
        }

        VerticalLayout {
            spacing: 6px;
            padding: 3px;

            for value[idx] in root.choices: Rectangle {
                border-radius: 3px;
                background: item-area.has-hover ? Palette.Orange : #0000;

                HorizontalLayout {
                    Text {
                        text: value;
                        color: item-area.has-hover ? Palette.Gray : Palette.Orange;
                        font-size: 16px;
                    }
                }

                item-area := TouchArea {
                    clicked => {
                        root.value = value;
						root.selected(value);
                    }
                }
            }
        }
    }
}

// Tab view component for settings
export component StylizedTabView {
    in property <[string]> tabs;
    in-out property <int> active-tab: 0;
	function tab-changed(index: int) {
		root.active-tab = index;
	}

    VerticalLayout {
        // Tab headers
        HorizontalLayout {
            height: 40px;
            spacing: 2px;

            for tab[index] in tabs : Rectangle {
                width: 120px;
                background: index == active-tab ? #18181880 : #18181840;
                border-width: 2px;
                border-color: index == active-tab ? Palette.Orange : Palette.Orange.darker(0.3);
                border-radius: 8px;

                BaseText {
                    text: tab;
                    font-size: 16px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                touchArea := TouchArea {
                    clicked => {
                        root.tab-changed(index);
                    }

                    mouse-cursor: pointer;
                }

                states [
                    hover when index != active-tab && touchArea.has-hover: {
                        background: #18181860;
                    }
                ]
            }
        }

        // Content area
        Rectangle {
            background: #18181880;
            border-width: 2px;
            border-color: Palette.Orange;
            border-radius: 8px;

            @children
        }
    }
}

// Custom number input (spinbox replacement)
export component StylizedSpinBox {
    in property <int> minimum;
    in property <int> maximum;
    in property <int> step: 1;
    in-out property <int> value;
    in property <bool> enabled: true;
    callback changed(int);


    HorizontalLayout {
        spacing: 2px;

        // Decrease button
        Rectangle {
            width: 100%;
            height: 100%;
            background: root.enabled ? #18181840 : #18181820;
            border-radius: self.height / 4;
            border-width: 2px;
            border-color: root.enabled ? Palette.Orange : Palette.Orange.darker(0.3);

            BaseText {
                text: "-";
                font-size: root.height * 0.6;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            decreaseTouchArea := TouchArea {
                enabled: root.enabled && root.value > root.minimum;
                clicked => {
                    root.value = max(root.minimum, root.value - root.step);
                    root.changed(root.value);
                }
            }

            states [
                pressed when root.enabled && decreaseTouchArea.pressed: {
                    background: #18181880;
                    border-color: Palette.Orange.darker(0.2);

                }
                hover when root.enabled && decreaseTouchArea.has-hover: {
                    background: #18181860;
                    decreaseTouchArea.mouse-cursor: pointer;
                }
            ]
        }

        // Value display
        Rectangle {
            width: 60px;
            background: root.enabled ? #18181840 : #18181820;
            border-radius: self.height / 4;
            border-width: 2px;
            border-color: root.enabled ? Palette.Orange : Palette.Orange.darker(0.3);

            BaseText {
                text: root.value;
                font-size: root.height * 0.6;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Increase button
        Rectangle {
            width: 100%;
            height: 100%;
            background: root.enabled ? #18181840 : #18181820;
            border-radius: self.height / 4;
            border-width: 2px;
            border-color: root.enabled ? Palette.Orange : Palette.Orange.darker(0.3);

            BaseText {
                text: "+";
                font-size: root.height * 0.6;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            increaseTouchArea := TouchArea {
                enabled: root.enabled && root.value < root.maximum;
                clicked => {
                    root.value = min(root.maximum, root.value + root.step);
                    root.changed(root.value);
                }
            }

            states [
                pressed when root.enabled && increaseTouchArea.pressed: {
                    background: #18181880;
                    border-color: Palette.Orange.darker(0.2);
                }
                hover when root.enabled && increaseTouchArea.has-hover: {
                    background: #18181860;
                    increaseTouchArea.mouse-cursor: pointer;
                }
            ]
        }
    }
}

// Card component for displaying and interacting with playing cards
export component Card {
    in property <int> number;  // 2-14 (14=Ace)
    in property <int> suit;    // 0=Hearts, 1=Clubs, 2=Diamonds, 3=Spades
    in property <bool> face-up: true;
    in property <bool> enabled: true;
    in property <bool> draggable: false;
	width: 100px;
    callback clicked;
    callback drag-started;
    callback drag-ended;

    Rectangle {
        width: root.width;
        height: root.width * 1.4;

        // Card face
        if root.face-up : Image {
            width: parent.width;
            height: parent.height;
            source: {
                if (root.suit == 0) { // Hearts
                    if (root.number == 2) { @image-url("../assets/images/cards/2_of_hearts.png") }
                    else if (root.number == 3) { @image-url("../assets/images/cards/3_of_hearts.png") }
                    else if (root.number == 4) { @image-url("../assets/images/cards/4_of_hearts.png") }
                    else if (root.number == 5) { @image-url("../assets/images/cards/5_of_hearts.png") }
                    else if (root.number == 6) { @image-url("../assets/images/cards/6_of_hearts.png") }
                    else if (root.number == 7) { @image-url("../assets/images/cards/7_of_hearts.png") }
                    else if (root.number == 8) { @image-url("../assets/images/cards/8_of_hearts.png") }
                    else if (root.number == 9) { @image-url("../assets/images/cards/9_of_hearts.png") }
                    else if (root.number == 10) { @image-url("../assets/images/cards/10_of_hearts.png") }
                    else if (root.number == 11) { @image-url("../assets/images/cards/jack_of_hearts.png") }
                    else if (root.number == 12) { @image-url("../assets/images/cards/queen_of_hearts.png") }
                    else if (root.number == 13) { @image-url("../assets/images/cards/king_of_hearts.png") }
                    else { @image-url("../assets/images/cards/ace_of_hearts.png") }
                } else if (root.suit == 1) { // Clubs
                    if (root.number == 2) { @image-url("../assets/images/cards/2_of_clubs.png") }
                    else if (root.number == 3) { @image-url("../assets/images/cards/3_of_clubs.png") }
                    else if (root.number == 4) { @image-url("../assets/images/cards/4_of_clubs.png") }
                    else if (root.number == 5) { @image-url("../assets/images/cards/5_of_clubs.png") }
                    else if (root.number == 6) { @image-url("../assets/images/cards/6_of_clubs.png") }
                    else if (root.number == 7) { @image-url("../assets/images/cards/7_of_clubs.png") }
                    else if (root.number == 8) { @image-url("../assets/images/cards/8_of_clubs.png") }
                    else if (root.number == 9) { @image-url("../assets/images/cards/9_of_clubs.png") }
                    else if (root.number == 10) { @image-url("../assets/images/cards/10_of_clubs.png") }
                    else if (root.number == 11) { @image-url("../assets/images/cards/jack_of_clubs.png") }
                    else if (root.number == 12) { @image-url("../assets/images/cards/queen_of_clubs.png") }
                    else if (root.number == 13) { @image-url("../assets/images/cards/king_of_clubs.png") }
                    else { @image-url("../assets/images/cards/ace_of_clubs.png") }
                } else if (root.suit == 2) { // Diamonds
                    if (root.number == 2) { @image-url("../assets/images/cards/2_of_diamonds.png") }
                    else if (root.number == 3) { @image-url("../assets/images/cards/3_of_diamonds.png") }
                    else if (root.number == 4) { @image-url("../assets/images/cards/4_of_diamonds.png") }
                    else if (root.number == 5) { @image-url("../assets/images/cards/5_of_diamonds.png") }
                    else if (root.number == 6) { @image-url("../assets/images/cards/6_of_diamonds.png") }
                    else if (root.number == 7) { @image-url("../assets/images/cards/7_of_diamonds.png") }
                    else if (root.number == 8) { @image-url("../assets/images/cards/8_of_diamonds.png") }
                    else if (root.number == 9) { @image-url("../assets/images/cards/9_of_diamonds.png") }
                    else if (root.number == 10) { @image-url("../assets/images/cards/10_of_diamonds.png") }
                    else if (root.number == 11) { @image-url("../assets/images/cards/jack_of_diamonds.png") }
                    else if (root.number == 12) { @image-url("../assets/images/cards/queen_of_diamonds.png") }
                    else if (root.number == 13) { @image-url("../assets/images/cards/king_of_diamonds.png") }
                    else { @image-url("../assets/images/cards/ace_of_diamonds.png") }
                } else { // Spades
                    if (root.number == 2) { @image-url("../assets/images/cards/2_of_spades.png") }
                    else if (root.number == 3) { @image-url("../assets/images/cards/3_of_spades.png") }
                    else if (root.number == 4) { @image-url("../assets/images/cards/4_of_spades.png") }
                    else if (root.number == 5) { @image-url("../assets/images/cards/5_of_spades.png") }
                    else if (root.number == 6) { @image-url("../assets/images/cards/6_of_spades.png") }
                    else if (root.number == 7) { @image-url("../assets/images/cards/7_of_spades.png") }
                    else if (root.number == 8) { @image-url("../assets/images/cards/8_of_spades.png") }
                    else if (root.number == 9) { @image-url("../assets/images/cards/9_of_spades.png") }
                    else if (root.number == 10) { @image-url("../assets/images/cards/10_of_spades.png") }
                    else if (root.number == 11) { @image-url("../assets/images/cards/jack_of_spades.png") }
                    else if (root.number == 12) { @image-url("../assets/images/cards/queen_of_spades.png") }
                    else if (root.number == 13) { @image-url("../assets/images/cards/king_of_spades.png") }
                    else { @image-url("../assets/images/cards/ace_of_spades.png") }
                }
            }
        }
        
        // Card back
        if !root.face-up : Image {
            width: parent.width;
            height: parent.height;
            source: @image-url("../assets/images/cards/back.png");
        }
        
        touchArea := TouchArea {
            enabled: root.enabled;

            pointer-event(event) => {
                if (root.draggable) {
                    if (event.kind == PointerEventKind.down) {
                        root.drag-started();
                    } else if (event.kind == PointerEventKind.up) {
                        root.drag-ended();
                    }
                }
            }
            
            clicked => {
                if (!root.draggable) {
                    root.clicked();
                }
            }
        }
        
        states [
            hover when root.enabled && touchArea.has-hover: {
                y: -10px;
                touchArea.mouse-cursor: root.draggable ? grab : pointer;
            }
            dragging when root.enabled && touchArea.pressed && root.draggable: {
                touchArea.mouse-cursor: grabbing;
            }
        ]
        
        animate y { duration: 100ms; easing: ease; }
    }
}

// Player display component for setup and game
export component PlayerDisplay {
    in property <string> username;
    in property <bool> is-human;
    in property <int> team;
    in property <bool> is-local;
    in property <bool> is-ready;
    in property <bool> is-current-turn;
    in property <bool> is-setup-mode;
    in property <bool> can-edit;
    in property <length> size: 256px;
    
    callback remove;
    callback team-changed(int);
    callback drag-started;
    callback drag-ended;
    callback position-changed(length, length);
    
    Rectangle {
        width: root.size;
        height: root.size * 1.5;
        
        VerticalLayout {
            padding: root.size / 16;
            spacing: root.size / 16;
            
            // Player icon
            Rectangle {
                height: root.size;
                
                Image {
                    width: parent.width;
                    height: parent.width;
                    source: root.is-human ? 
                        @image-url("../assets/images/personIcon.png") : 
                        @image-url("../assets/images/botIcon.png");
                    colorize: Palette.Orange;
                }
                
                // Ready indicator
                if root.is-ready: Image {
                    x: parent.width - self.width - 4px;
                    y: 4px;
                    width: parent.width / 4;
                    height: self.width;
                    source: @image-url("../assets/images/checkmark.png");
                }
                
                // Current turn indicator
                if root.is-current-turn: Rectangle {
                    width: parent.width + 8px;
                    height: parent.height + 8px;
                    x: -4px;
                    y: -4px;
                    border-width: 4px;
                    border-radius: 8px;
                    border-color: Palette.Orange;
                    animate border-color { duration: 500ms; }
                }
                
                touchArea := TouchArea {
                    enabled: root.is-setup-mode && root.can-edit;
                    
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            root.drag-started();
                        } else if (event.kind == PointerEventKind.up) {
                            root.drag-ended();
                        }
                    }
                }
            }
            
            // Player info
            if !root.is-local || root.is-setup-mode: VerticalLayout {
                spacing: 4px;
                
                // Username
                BaseText {
                    text: root.username;
                    font-size: root.size / 8;
                    horizontal-alignment: center;
                }
                
                // Team number (in setup mode or when teams are custom)
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    
                    BaseText {
                        text: "Team:";
                        font-size: root.size / 10;
                        vertical-alignment: center;
                    }
                    
                    if root.is-setup-mode && root.can-edit: StylizedSpinBox {
                        height: root.size / 8;
                        value: root.team;
                        minimum: 0;
                        maximum: 7;
                        changed(value) => {
                            root.team-changed(value);
                        }
                    }
					
					if !root.is-setup-mode || !root.can-edit: BaseText {
                        text: root.team;
                        font-size: root.size / 10;
                        vertical-alignment: center;
                    }
                }
                
                // Remove button (only in setup)
                if root.is-setup-mode && root.can-edit: StylizedButton {
                    width: root.size / 2;
                    height: root.size / 8;
                    text: "Remove";
                    font-size: root.size / 10;
                    clicked => { root.remove(); }
                }
            }
        }
        
        states [
            hover when root.is-setup-mode && root.can-edit && touchArea.has-hover: {
                touchArea.mouse-cursor: grab;
            }
            dragging when root.is-setup-mode && root.can-edit && touchArea.pressed: {
                touchArea.mouse-cursor: grabbing;
            }
        ]
    }
}

export component ConfirmationDialog inherits Dialog {
    in property <string> message;
    callback confirmed;
    callback cancelled;

    title: "Confirm";

    VerticalLayout {
        alignment: center;
        padding: 20px;

        BaseText {
            text: root.message;
            font-size: 20px;
            horizontal-alignment: center;
            wrap: true;
        }
    }

    StandardButton { kind: ok; clicked => { root.confirmed(); } }
    StandardButton { kind: cancel; clicked => { root.cancelled(); } }
}