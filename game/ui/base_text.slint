import {Palette} from "global.slint";

// Base text style used throughout the app
export component BaseText {
	in property <string> text;
	in property <length> font-size: 16px;
	in property <bool> bold: false;
	in property <int> font-weight: root.bold ? 900 : 400;
	in property <TextHorizontalAlignment> horizontal-alignment: TextHorizontalAlignment.left;
	in property <TextVerticalAlignment> vertical-alignment: TextVerticalAlignment.top;
	in property <bool> wrap: false;

	Text {
		text: root.text;
		font-size: root.font-size;
		font-weight: root.font-weight;
		color: Palette.Orange;
		stroke: Palette.Gray;
		stroke-width: root.font-size / 20px * 1px;
		horizontal-alignment: root.horizontal-alignment;
		vertical-alignment: root.vertical-alignment;
		wrap: root.wrap ? TextWrap.word-wrap : TextWrap.no-wrap;
		width: root.width;
		height: root.height;
	}
}