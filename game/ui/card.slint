// Card component for displaying and interacting with playing cards
export component Card {
    in property <int> number;  // 2-14 (14=Ace)
    in property <int> suit;    // 0=Hearts, 1=Clubs, 2=Diamonds, 3=Spades
    in property <bool> face-up: true;
    in property <bool> enabled: true;
    in property <bool> draggable: false;
	width: 100px;
    callback clicked;
    callback drag-started;
    callback drag-ended;

    Rectangle {
        width: root.width;
        height: root.width * 1.4;

        // Card face
        if root.face-up : Image {
            width: parent.width;
            height: parent.height;
            source: {
                if (root.suit == 0) { // Hearts
                    if (root.number == 2) { @image-url("../assets/images/cards/2_of_hearts.png") }
                    else if (root.number == 3) { @image-url("../assets/images/cards/3_of_hearts.png") }
                    else if (root.number == 4) { @image-url("../assets/images/cards/4_of_hearts.png") }
                    else if (root.number == 5) { @image-url("../assets/images/cards/5_of_hearts.png") }
                    else if (root.number == 6) { @image-url("../assets/images/cards/6_of_hearts.png") }
                    else if (root.number == 7) { @image-url("../assets/images/cards/7_of_hearts.png") }
                    else if (root.number == 8) { @image-url("../assets/images/cards/8_of_hearts.png") }
                    else if (root.number == 9) { @image-url("../assets/images/cards/9_of_hearts.png") }
                    else if (root.number == 10) { @image-url("../assets/images/cards/10_of_hearts.png") }
                    else if (root.number == 11) { @image-url("../assets/images/cards/jack_of_hearts.png") }
                    else if (root.number == 12) { @image-url("../assets/images/cards/queen_of_hearts.png") }
                    else if (root.number == 13) { @image-url("../assets/images/cards/king_of_hearts.png") }
                    else { @image-url("../assets/images/cards/ace_of_hearts.png") }
                } else if (root.suit == 1) { // Clubs
                    if (root.number == 2) { @image-url("../assets/images/cards/2_of_clubs.png") }
                    else if (root.number == 3) { @image-url("../assets/images/cards/3_of_clubs.png") }
                    else if (root.number == 4) { @image-url("../assets/images/cards/4_of_clubs.png") }
                    else if (root.number == 5) { @image-url("../assets/images/cards/5_of_clubs.png") }
                    else if (root.number == 6) { @image-url("../assets/images/cards/6_of_clubs.png") }
                    else if (root.number == 7) { @image-url("../assets/images/cards/7_of_clubs.png") }
                    else if (root.number == 8) { @image-url("../assets/images/cards/8_of_clubs.png") }
                    else if (root.number == 9) { @image-url("../assets/images/cards/9_of_clubs.png") }
                    else if (root.number == 10) { @image-url("../assets/images/cards/10_of_clubs.png") }
                    else if (root.number == 11) { @image-url("../assets/images/cards/jack_of_clubs.png") }
                    else if (root.number == 12) { @image-url("../assets/images/cards/queen_of_clubs.png") }
                    else if (root.number == 13) { @image-url("../assets/images/cards/king_of_clubs.png") }
                    else { @image-url("../assets/images/cards/ace_of_clubs.png") }
                } else if (root.suit == 2) { // Diamonds
                    if (root.number == 2) { @image-url("../assets/images/cards/2_of_diamonds.png") }
                    else if (root.number == 3) { @image-url("../assets/images/cards/3_of_diamonds.png") }
                    else if (root.number == 4) { @image-url("../assets/images/cards/4_of_diamonds.png") }
                    else if (root.number == 5) { @image-url("../assets/images/cards/5_of_diamonds.png") }
                    else if (root.number == 6) { @image-url("../assets/images/cards/6_of_diamonds.png") }
                    else if (root.number == 7) { @image-url("../assets/images/cards/7_of_diamonds.png") }
                    else if (root.number == 8) { @image-url("../assets/images/cards/8_of_diamonds.png") }
                    else if (root.number == 9) { @image-url("../assets/images/cards/9_of_diamonds.png") }
                    else if (root.number == 10) { @image-url("../assets/images/cards/10_of_diamonds.png") }
                    else if (root.number == 11) { @image-url("../assets/images/cards/jack_of_diamonds.png") }
                    else if (root.number == 12) { @image-url("../assets/images/cards/queen_of_diamonds.png") }
                    else if (root.number == 13) { @image-url("../assets/images/cards/king_of_diamonds.png") }
                    else { @image-url("../assets/images/cards/ace_of_diamonds.png") }
                } else { // Spades
                    if (root.number == 2) { @image-url("../assets/images/cards/2_of_spades.png") }
                    else if (root.number == 3) { @image-url("../assets/images/cards/3_of_spades.png") }
                    else if (root.number == 4) { @image-url("../assets/images/cards/4_of_spades.png") }
                    else if (root.number == 5) { @image-url("../assets/images/cards/5_of_spades.png") }
                    else if (root.number == 6) { @image-url("../assets/images/cards/6_of_spades.png") }
                    else if (root.number == 7) { @image-url("../assets/images/cards/7_of_spades.png") }
                    else if (root.number == 8) { @image-url("../assets/images/cards/8_of_spades.png") }
                    else if (root.number == 9) { @image-url("../assets/images/cards/9_of_spades.png") }
                    else if (root.number == 10) { @image-url("../assets/images/cards/10_of_spades.png") }
                    else if (root.number == 11) { @image-url("../assets/images/cards/jack_of_spades.png") }
                    else if (root.number == 12) { @image-url("../assets/images/cards/queen_of_spades.png") }
                    else if (root.number == 13) { @image-url("../assets/images/cards/king_of_spades.png") }
                    else { @image-url("../assets/images/cards/ace_of_spades.png") }
                }
            }
        }
        
        // Card back
        if !root.face-up : Image {
            width: parent.width;
            height: parent.height;
            source: @image-url("../assets/images/cards/back.png");
        }
        
        touchArea := TouchArea {
            enabled: root.enabled;

            pointer-event(event) => {
                if (root.draggable) {
                    if (event.kind == PointerEventKind.down) {
                        root.drag-started();
                    } else if (event.kind == PointerEventKind.up) {
                        root.drag-ended();
                    }
                }
            }
            
            clicked => {
                if (!root.draggable) {
                    root.clicked();
                }
            }
        }
        
        states [
            hover when root.enabled && touchArea.has-hover: {
                y: -10px;
                touchArea.mouse-cursor: root.draggable ? grab : pointer;
            }
            dragging when root.enabled && touchArea.pressed && root.draggable: {
                touchArea.mouse-cursor: grabbing;
            }
        ]
        
        animate y { duration: 100ms; easing: ease; }
    }
}