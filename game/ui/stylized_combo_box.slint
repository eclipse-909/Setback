import {Palette} from "global.slint";
import {BaseText} from "base_text.slint";

export component StylizedComboBox inherits Rectangle {
    in-out property <string> value;
    in property <[string]> choices;
	in property <bool> enabled <=> button.enabled;

	callback selected(choice: string);

    border-radius: 3px;
    border-width: 2px;
    border-color: Palette.Orange;
    height: 32px;
    min-width: label.x + label.width + i.width;
    horizontal-stretch: 1;

    label := BaseText {
		vertical-alignment: center;
        horizontal-alignment: left;
        text <=> root.value;
        height: 100%;
        x: 12px;
		font-size: root.height * 0.6;
	}

    i := Image {
        source: @image-url("../assets/images/dropdown-arrow.png");
        colorize: Palette.Orange;
        height: 40%;
        width: self.height;
        image-fit: contain;
        x: parent.width - self.width - self.y;
        y: (parent.height - self.height)/2;
    }

    button :=TouchArea {
        clicked => { popup.show(); }

        width: 100%;
        height: 100%;
    }

    popup := PopupWindow {
        x:0;
        y: root.height;
        width: root.width;

        Rectangle {
            background: #181818e0;
            border-radius: 3px;
            border-width: 2px;
            border-color: Palette.Orange;
        }

        VerticalLayout {
            spacing: 6px;
            padding: 3px;

            for value[idx] in root.choices: Rectangle {
                border-radius: 3px;
                background: item-area.has-hover ? Palette.Orange : #0000;

                HorizontalLayout {
                    Text {
                        text: value;
                        color: item-area.has-hover ? Palette.Gray : Palette.Orange;
                        font-size: 16px;
                    }
                }

                item-area := TouchArea {
                    clicked => {
                        root.value = value;
						root.selected(value);
                    }
                }
            }
        }
    }
}