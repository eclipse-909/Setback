import {BaseText} from "base_text.slint";
import {Palette} from "global.slint";

// Enhanced version of your existing MenuButton with more customization
export component StylizedButton {
	in property <string> text;
	in property <length> font-size: 16px;
	width: 450px;
	height: font-size * 2;
	in property <bool> enabled: true;
	callback clicked;

	Rectangle {
		width: root.width;
		height: root.height;
		background: root.enabled ? #18181840 : #18181820;
		border-radius: root.height / 4;
		border-width: 2px;
		border-color: root.enabled ? Palette.Orange : Palette.Orange.darker(0.3);

		touchArea := TouchArea {
			enabled: root.enabled;
			width: 100%;
			height: 100%;

			clicked => {
				if (root.enabled) { root.clicked(); }
			}

			BaseText {
				text: root.text;
				font-size: root.font-size;
				bold: true;
				x: (parent.width - self.width) / 2;
				y: (parent.height - self.height) / 2;
			}
		}

		animate background { duration: 100ms; }
		animate border-color { duration: 100ms; }

		states [
			pressed when root.enabled && touchArea.pressed: {
				background: #18181880;
				border-color: Palette.Orange.darker(0.2);
			}
			hover when root.enabled && touchArea.has-hover: {
				background: #18181860;
				touchArea.mouse-cursor: pointer;
			}
		]
	}
}