import {Palette} from "global.slint";
import {BaseText} from "base_text.slint";

// Custom number input (spinbox replacement)
export component StylizedSpinBox {
	in property <int> minimum;
	in property <int> maximum;
	in property <int> step: 1;
	in-out property <int> value;
	in property <bool> enabled: true;
	callback changed(int);

	height: 32px;  // Default height if not specified

	HorizontalLayout {
		height: parent.height;
		spacing: 2px;

		// Decrease button
		Rectangle {
			width: 100%;
			height: parent.height;
			background: root.enabled ? #18181840 : #18181820;
			border-radius: self.height / 4;
			border-width: 2px;
			border-color: root.enabled ? Palette.Orange : Palette.Orange.darker(0.3);

			BaseText {
				text: "-";
				font-size: root.height * 0.6;
				horizontal-alignment: center;
				vertical-alignment: center;
			}

			decreaseTouchArea := TouchArea {
				enabled: root.enabled && root.value > root.minimum;
				clicked => {
					root.value = max(root.minimum, root.value - root.step);
					root.changed(root.value);
				}
			}

			states [
				pressed when root.enabled && decreaseTouchArea.pressed: {
					background: #18181880;
					border-color: Palette.Orange.darker(0.2);
				}
				hover when root.enabled && decreaseTouchArea.has-hover: {
					background: #18181860;
					decreaseTouchArea.mouse-cursor: pointer;
				}
			]
		}

		// Value display
		Rectangle {
			width: 60px;
			height: parent.height;
			background: root.enabled ? #18181840 : #18181820;
			border-radius: self.height / 4;
			border-width: 2px;
			border-color: root.enabled ? Palette.Orange : Palette.Orange.darker(0.3);

			BaseText {
				text: root.value;
				font-size: root.height * 0.6;
				horizontal-alignment: center;
				vertical-alignment: center;
			}
		}

		// Increase button
		Rectangle {
			width: 100%;
			height: parent.height;
			background: root.enabled ? #18181840 : #18181820;
			border-radius: self.height / 4;
			border-width: 2px;
			border-color: root.enabled ? Palette.Orange : Palette.Orange.darker(0.3);

			BaseText {
				text: "+";
				font-size: root.height * 0.6;
				horizontal-alignment: center;
				vertical-alignment: center;
			}

			increaseTouchArea := TouchArea {
				enabled: root.enabled && root.value < root.maximum;
				clicked => {
					root.value = min(root.maximum, root.value + root.step);
					root.changed(root.value);
				}
			}

			states [
				pressed when root.enabled && increaseTouchArea.pressed: {
					background: #18181880;
					border-color: Palette.Orange.darker(0.2);
				}
				hover when root.enabled && increaseTouchArea.has-hover: {
					background: #18181860;
					increaseTouchArea.mouse-cursor: pointer;
				}
			]
		}
	}
}