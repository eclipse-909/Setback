import {BaseText} from "base_text.slint";
import {StylizedCheckbox} from "stylized_checkbox.slint";
import {StylizedSlider} from "stylized_slider.slint";
import {StylizedTabView} from "stylized_tab_view.slint";
import {StylizedComboBox} from "stylized_combo_box.slint";
import {StylizedButton} from "stylized_button.slint";
import {GlobalSettings} from "global.slint";

// Settings component that can be reused in both the settings scene and game popup
export component SettingsPanel {
	in property <bool> show-back-button: true;
	callback back;
	
	VerticalLayout {
		padding: 20px;
		spacing: 20px;

		// Settings tabs
		settings-tabs := StylizedTabView {
			tabs: ["Audio", "Video", "Keybinds", "Account"];
			
			// Audio Settings
			if settings-tabs.active-tab == 0 : VerticalLayout {
				padding: 40px;
				spacing: 30px;
				
				HorizontalLayout {
					spacing: 20px;
					alignment: space-between;
					width: 600px;
					Image {
						source: @image-url("../assets/images/volume-high.png");
						width: 32px;
						height: 32px;
					}
					BaseText {
						text: "Master Volume";
						font-size: 24px;
						vertical-alignment: center;
					}
					StylizedSlider {
						width: 300px;
						height: 32px;
						value: GlobalSettings.settings.master_volume;
						step: 0.1;
					}
				}
				
				HorizontalLayout {
					spacing: 20px;
					alignment: space-between;
					width: 600px;
					Image {
						source: @image-url("../assets/images/volume-high.png");
						width: 32px;
						height: 32px;
					}
					BaseText {
						text: "Music Volume";
						font-size: 24px;
						vertical-alignment: center;
					}
					StylizedSlider {
						width: 300px;
						height: 32px;
						value: GlobalSettings.settings.music_volume;
						step: 0.1;
					}
				}
				
				HorizontalLayout {
					spacing: 20px;
					alignment: space-between;
					width: 600px;
					Image {
						source: @image-url("../assets/images/volume-high.png");
						width: 32px;
						height: 32px;
					}
					BaseText {
						text: "UI Volume";
						font-size: 24px;
						vertical-alignment: center;
					}
					StylizedSlider {
						width: 300px;
						height: 32px;
						value: GlobalSettings.settings.ui_volume;
						step: 0.1;
					}
				}
			}
			
			// Video Settings
			if settings-tabs.active-tab == 1 : VerticalLayout {
				padding: 40px;
				spacing: 30px;
				
				HorizontalLayout {
					spacing: 20px;
					alignment: space-between;
					width: 500px;
					BaseText {
						text: "Resolution";
						font-size: 24px;
						vertical-alignment: center;
					}
					StylizedComboBox {
						width: 200px;
						height: 32px;
						choices: ["1920x1080", "1280x720", "800x600"];
						value: "1920x1080";
						selected(value) => {
							// Handle resolution change
						}
					}
				}
				
				HorizontalLayout {
					spacing: 20px;
					alignment: space-between;
					width: 500px;
					BaseText {
						text: "Framerate";
						font-size: 24px;
						vertical-alignment: center;
					}
					StylizedComboBox {
						width: 200px;
						height: 32px;
						choices: ["120 FPS", "60 FPS", "30 FPS", "Unlimited"];
						value: GlobalSettings.settings.framerate;
						selected(value) => {
							// Handle framerate change
						}
					}
				}
				
				HorizontalLayout {
					spacing: 20px;
					alignment: space-between;
					width: 500px;
					BaseText {
						text: "VSync";
						font-size: 24px;
						vertical-alignment: center;
					}
					StylizedCheckbox {
						checked: GlobalSettings.settings.vsync;
					}
				}
				
				HorizontalLayout {
					spacing: 20px;
					alignment: space-between;
					width: 500px;
					BaseText {
						text: "Triple Buffering";
						font-size: 24px;
						vertical-alignment: center;
					}
					StylizedCheckbox {
						checked: GlobalSettings.settings.triple_buffering;
					}
				}
			}
			
			// Keybinds Settings
			if settings-tabs.active-tab == 2 : VerticalLayout {
				padding: 40px;
				spacing: 30px;
				
				// Bidding Keybinds
				Rectangle {
					background: #18181840;
					border-radius: 8px;
					padding: 20px;
					height: 285px;
					
					VerticalLayout {
						spacing: 15px;
						alignment: start;
						
						BaseText {
							text: "Bidding";
							font-size: 28px;
							font-weight: 700;
							horizontal-alignment: center;
						}
						
						for bind[i] in [
							{ name: "Pass", key: GlobalSettings.settings.pass_keybind },
							{ name: "Bid 2", key: GlobalSettings.settings.bid_2_keybind },
							{ name: "Bid 3", key: GlobalSettings.settings.bid_3_keybind },
							{ name: "Bid 4", key: GlobalSettings.settings.bid_4_keybind },
							{ name: "Bid 5", key: GlobalSettings.settings.bid_5_keybind }
						] : HorizontalLayout {
							spacing: 20px;
							alignment: space-around;
							width: 600px;
							
							Rectangle {
								width: 200px;
								BaseText {
									text: bind.name;
									font-size: 24px;
									horizontal-alignment: center;
									vertical-alignment: center;
								}
							}
							
							Rectangle {
								width: 100px;
								background: #ffffff20;
								border-radius: 4px;
								
								BaseText {
									text: bind.key;
									font-size: 20px;
									horizontal-alignment: center;
									vertical-alignment: center;
								}
								
								TouchArea {
									clicked => {
										// TODO: Implement key binding logic
									}
								}
							}
							
							StylizedButton {
								text: "Reset";
								width: 80px;
								height: 32px;
								font-size: 16px;
							}
						}
					}
				}
				
				// Playing Cards Keybinds
				Rectangle {
					background: #18181840;
					border-radius: 8px;
					padding: 20px;
					height: 335px;
					
					VerticalLayout {
						spacing: 15px;
						alignment: start;
						
						BaseText {
							text: "Playing Cards";
							font-size: 28px;
							font-weight: 700;
							horizontal-alignment: center;
						}
						
						for bind[i] in [
							{ name: "Play Card 1", key: GlobalSettings.settings.play_card_1_keybind },
							{ name: "Play Card 2", key: GlobalSettings.settings.play_card_2_keybind },
							{ name: "Play Card 3", key: GlobalSettings.settings.play_card_3_keybind },
							{ name: "Play Card 4", key: GlobalSettings.settings.play_card_4_keybind },
							{ name: "Play Card 5", key: GlobalSettings.settings.play_card_5_keybind },
							{ name: "Play Card 6", key: GlobalSettings.settings.play_card_6_keybind }
						] : HorizontalLayout {
							spacing: 20px;
							alignment: space-around;
							width: 600px;
							
							Rectangle { width: 200px;
								BaseText {
									text: bind.name;
									font-size: 24px;
									horizontal-alignment: center;
									vertical-alignment: center;
								}
							}
							
							Rectangle { width: 100px;
								background: #ffffff20;
								border-radius: 4px;
								
								BaseText {
									text: bind.key;
									font-size: 20px;
									horizontal-alignment: center;
									vertical-alignment: center;
								}
								
								TouchArea {
									clicked => {
										// TODO: Implement key binding logic
									}
								}
							}
							
							StylizedButton {
								text: "Reset";
								width: 80px;
								height: 32px;
								font-size: 16px;
							}
						}
					}
				}
				
				// Other Keybinds
				Rectangle {
					background: #18181840;
					border-radius: 8px;
					padding: 20px;
					height: 100px;
					
					VerticalLayout {
						spacing: 15px;
						alignment: start;
						
						BaseText {
							text: "Other";
							font-size: 28px;
							font-weight: 700;
							horizontal-alignment: center;
						}
						
						HorizontalLayout {
							spacing: 20px;
							alignment: space-around;
							width: 600px;
							
							Rectangle {
								width: 200px;
								BaseText {
									text: "Toggle Settings";
									font-size: 24px;
									horizontal-alignment: center;
									vertical-alignment: center;
								}
							}
							
							Rectangle {
								width: 100px;
								background: #ffffff20;
								border-radius: 4px;
								
								BaseText {
									text: GlobalSettings.settings.toggle_settings_keybind;
									font-size: 20px;
									horizontal-alignment: center;
									vertical-alignment: center;
								}
								
								TouchArea {
									clicked => {
										// TODO: Implement key binding logic
									}
								}
							}
							
							StylizedButton {
								text: "Reset";
								width: 80px;
								height: 32px;
								font-size: 16px;
							}
						}
					}
				}
			}

			if settings-tabs.active-tab == 3 : VerticalLayout {
				padding: 40px;
				spacing: 30px;

				/*
				Account settings:

				if signed-in:
					display text: "Signed in as {username}"
					logout button

				if not signed-in:
					sign-in button
						//popup with login interface
					sign-up button
						//opens website in browser
				*/	
			}
		}
		
		// Version display
		BaseText {
			text: "Version 0.1.0"; // TODO: Make this configurable
			font-size: 16px;
			horizontal-alignment: center;
		}
	}
}