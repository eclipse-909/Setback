import {ScrollView} from "std-widgets.slint";
import { 
	BaseText, StylizedButton, StylizedCheckbox, StylizedSlider,
	StylizedComboBox, StylizedTabView, StylizedSpinBox, Card,
	PlayerDisplay, Palette, ConfirmationDialog
} from "components.slint";

///Game state which stores what scene is currently active.
export enum SceneType {
	MainMenu,
	Setup,
	Multiplayer,
	Game,
	Settings
}

enum HostType {
	///Not in a game.
	None,
	SingleplayerSetup,
	SingleplayerPlaying,
	///Created a multiplayer game as the host.
	Host,
	///Joined a multiplayer game as a client.
	Client
}

export struct Player {
	username: string,
	team: int,
	is_human: bool,
	local: bool,
	x: length,
	y: length
}

export enum Suit {
	Hearts,
	Clubs,
	Diamonds,
	Spades
}

export struct Card {
	suit: Suit,
	number: int
}

enum Comparison {
	Equal,
	LessOrEqual,
	GreaterOrEqual,
	Less,
	Greater,
	NotEqual
}

export struct Game {
	join_code: string,
	players: int,
	max_players: int,
	std_team: bool,
	win_by_2: bool,
	negative_scores: bool,
	dealer_override: bool
}

export enum ErrorLocation {
	None,
	MainMenu,
	MultiplayerPopup,
	///Whichever of the remaining scenes the error occurred in (Multiplayer, Setup, Game)
	Scene
}

@rust-attr(derive(bincode::Encode, bincode::Decode))
export struct Settings {
	master_volume: float,
	music_volume: float,
	ui_volume: float,
	resolution: string,
	framerate: string,
	vsync: bool,
	triple_buffering: bool,
	pass_keybind: string,
	bid_2_keybind: string,
	bid_3_keybind: string,
	bid_4_keybind: string,
	bid_5_keybind: string,
	play_card_1_keybind: string,
	play_card_2_keybind: string,
	play_card_3_keybind: string,
	play_card_4_keybind: string,
	play_card_5_keybind: string,
	play_card_6_keybind: string,
	toggle_settings_keybind: string
}

component SetupPlayer inherits HorizontalLayout {
	in property <string> username;
	in property <bool> human;
	in property <int> team;
	in property <bool> humanVisible;
	in property <bool> teamVisible;

    height: 256px;

	touchArea := TouchArea {
		width: root.height;
        height: root.height;

		Image {
			width: root.height;
			height: root.height;
			source: root.human ? @image-url("../assets/images/personIcon.png") : @image-url("../assets/images/botIcon.png");
			colorize: #000000;
			image-fit: contain;
		}

		states [
			pressed when self.pressed: {
				touchArea.mouse-cursor: grabbing;
			}
			hover when self.has-hover: {
				touchArea.mouse-cursor: grab;
			}
		]
	}

	VerticalLayout {
		alignment: start;
		spacing: 10px;

		xBG := Rectangle {
            background: #18181840;
            width: 30px;
            height: 30px;
            border-width: 4px;
            border-color: Palette.Orange;
            border-radius: 10px;

            xTouchArea := TouchArea {
                width: 30px;
                height: 30px;

                checkmark := Image {
                    source: @image-url("../assets/images/x.png");
                    image-fit: contain;
                    width: 18px;
                    height: 18px;
                }

                clicked => {
                    //TODO delete this player
                }
            }

            animate background { duration: 32ms; }

            states [
                hover when xTouchArea.has-hover: {
                    xBG.background: #18181880;
                    xTouchArea.mouse-cursor: pointer;
                }
                pressed when xTouchArea.pressed: {
                    xBG.background: #181818c0;
                    xTouchArea.mouse-cursor: pointer;
                }
            ]
        }
		BaseText {
			text: username;
			font-size: 20px;
		}
		if humanVisible: StylizedCheckbox {
			text: "Human";
			enabled: human;
		}
		HorizontalLayout {
			BaseText {
				text: "Team Number:";
				font-size: 20px;
			}
			if teamVisible: StylizedSpinBox {
				value: team;
				minimum: 0;
				maximum: 7;
			}
		}
	}
}

// Settings component that can be reused in both the settings scene and game popup
component SettingsPanel {
    in property <bool> show-back-button: true;
    callback back;
    
    VerticalLayout {
        padding: 20px;
        spacing: 20px;

        // Settings tabs
        settings-tabs := StylizedTabView {
            tabs: ["Audio", "Video", "Keybinds", "Account"];
            
            // Audio Settings
            if settings-tabs.active-tab == 0 : VerticalLayout {
                padding: 40px;
                spacing: 30px;
                
                HorizontalLayout {
                    spacing: 20px;
					alignment: space-between;
					width: 600px;
                    Image {
                        source: @image-url("../assets/images/volume-high.png");
                        width: 32px;
                        height: 32px;
                    }
                    BaseText {
                        text: "Master Volume";
                        font-size: 24px;
                        vertical-alignment: center;
                    }
                    StylizedSlider {
                        width: 300px;
                        height: 32px;
                        value: GlobalSettings.settings.master_volume;
						step: 0.1;
                    }
                }
                
                HorizontalLayout {
					spacing: 20px;
					alignment: space-between;
					width: 600px;
                    Image {
                        source: @image-url("../assets/images/volume-high.png");
                        width: 32px;
                        height: 32px;
                    }
                    BaseText {
                        text: "Music Volume";
                        font-size: 24px;
                        vertical-alignment: center;
                    }
                    StylizedSlider {
                        width: 300px;
                        height: 32px;
                        value: GlobalSettings.settings.music_volume;
						step: 0.1;
                    }
                }
                
                HorizontalLayout {
					spacing: 20px;
					alignment: space-between;
					width: 600px;
                    Image {
                        source: @image-url("../assets/images/volume-high.png");
                        width: 32px;
                        height: 32px;
                    }
                    BaseText {
                        text: "UI Volume";
                        font-size: 24px;
                        vertical-alignment: center;
                    }
                    StylizedSlider {
                        width: 300px;
                        height: 32px;
                        value: GlobalSettings.settings.ui_volume;
						step: 0.1;
                    }
                }
            }
            
            // Video Settings
            if settings-tabs.active-tab == 1 : VerticalLayout {
                padding: 40px;
                spacing: 30px;
                
                HorizontalLayout {
                    spacing: 20px;
					alignment: space-between;
					width: 500px;
                    BaseText {
                        text: "Resolution";
                        font-size: 24px;
                        vertical-alignment: center;
                    }
                    StylizedComboBox {
                        width: 200px;
                        height: 32px;
                        choices: ["1920x1080", "1280x720", "800x600"];
                        value: "1920x1080";
                        selected(value) => {
                            // Handle resolution change
                        }
                    }
                }
                
                HorizontalLayout {
                    spacing: 20px;
					alignment: space-between;
					width: 500px;
                    BaseText {
                        text: "Framerate";
                        font-size: 24px;
                        vertical-alignment: center;
                    }
                    StylizedComboBox {
                        width: 200px;
                        height: 32px;
                        choices: ["120 FPS", "60 FPS", "30 FPS", "Unlimited"];
                        value: GlobalSettings.settings.framerate;
                        selected(value) => {
                            // Handle framerate change
                        }
                    }
                }
                
                HorizontalLayout {
					spacing: 20px;
					alignment: space-between;
					width: 500px;
                    BaseText {
                        text: "VSync";
                        font-size: 24px;
                        vertical-alignment: center;
                    }
                    StylizedCheckbox {
                        checked: GlobalSettings.settings.vsync;
                    }
                }
                
                HorizontalLayout {
                    spacing: 20px;
					alignment: space-between;
					width: 500px;
                    BaseText {
                        text: "Triple Buffering";
                        font-size: 24px;
                        vertical-alignment: center;
                    }
                    StylizedCheckbox {
                        checked: GlobalSettings.settings.triple_buffering;
                    }
                }
            }
            
            // Keybinds Settings
            if settings-tabs.active-tab == 2 : VerticalLayout {
                padding: 40px;
                spacing: 30px;
                
                // Bidding Keybinds
                Rectangle {
                    background: #18181840;
                    border-radius: 8px;
                    padding: 20px;
					height: 285px;
                    
                    VerticalLayout {
                        spacing: 15px;
						alignment: start;
                        
                        BaseText {
                            text: "Bidding";
                            font-size: 28px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        
                        for bind[i] in [
                            { name: "Pass", key: GlobalSettings.settings.pass_keybind },
                            { name: "Bid 2", key: GlobalSettings.settings.bid_2_keybind },
                            { name: "Bid 3", key: GlobalSettings.settings.bid_3_keybind },
                            { name: "Bid 4", key: GlobalSettings.settings.bid_4_keybind },
                            { name: "Bid 5", key: GlobalSettings.settings.bid_5_keybind }
                        ] : HorizontalLayout {
                            spacing: 20px;
                            alignment: space-around;
                            width: 600px;
                            
                            Rectangle {
								width: 200px;
                                BaseText {
                                    text: bind.name;
                                    font-size: 24px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            
                            Rectangle {
								width: 100px;
                                background: #ffffff20;
                                border-radius: 4px;
                                
                                BaseText {
                                    text: bind.key;
                                    font-size: 20px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                
                                TouchArea {
                                    clicked => {
                                        // TODO: Implement key binding logic
                                    }
                                }
                            }
                            
                            StylizedButton {
                                text: "Reset";
                                width: 80px;
                                height: 32px;
                                font-size: 16px;
                            }
                        }
                    }
                }
                
                // Playing Cards Keybinds
                Rectangle {
                    background: #18181840;
                    border-radius: 8px;
                    padding: 20px;
					height: 335px;
                    
                    VerticalLayout {
                        spacing: 15px;
						alignment: start;
                        
                        BaseText {
                            text: "Playing Cards";
                            font-size: 28px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        
                        for bind[i] in [
                            { name: "Play Card 1", key: GlobalSettings.settings.play_card_1_keybind },
                            { name: "Play Card 2", key: GlobalSettings.settings.play_card_2_keybind },
                            { name: "Play Card 3", key: GlobalSettings.settings.play_card_3_keybind },
                            { name: "Play Card 4", key: GlobalSettings.settings.play_card_4_keybind },
                            { name: "Play Card 5", key: GlobalSettings.settings.play_card_5_keybind },
                            { name: "Play Card 6", key: GlobalSettings.settings.play_card_6_keybind }
                        ] : HorizontalLayout {
                            spacing: 20px;
                            alignment: space-around;
                            width: 600px;
                            
                            Rectangle { width: 200px;
                                BaseText {
                                    text: bind.name;
                                    font-size: 24px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            
                            Rectangle { width: 100px;
                                background: #ffffff20;
                                border-radius: 4px;
                                
                                BaseText {
                                    text: bind.key;
                                    font-size: 20px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                
                                TouchArea {
                                    clicked => {
                                        // TODO: Implement key binding logic
                                    }
                                }
                            }
                            
                            StylizedButton {
                                text: "Reset";
                                width: 80px;
                                height: 32px;
                                font-size: 16px;
                            }
                        }
                    }
                }
                
                // Other Keybinds
                Rectangle {
                    background: #18181840;
                    border-radius: 8px;
                    padding: 20px;
					height: 100px;
                    
                    VerticalLayout {
                        spacing: 15px;
						alignment: start;
                        
                        BaseText {
                            text: "Other";
                            font-size: 28px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        
                        HorizontalLayout {
                            spacing: 20px;
                            alignment: space-around;
                            width: 600px;
                            
                            Rectangle {
								width: 200px;
                                BaseText {
                                    text: "Toggle Settings";
                                    font-size: 24px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            
                            Rectangle {
								width: 100px;
                                background: #ffffff20;
                                border-radius: 4px;
                                
                                BaseText {
                                    text: GlobalSettings.settings.toggle_settings_keybind;
                                    font-size: 20px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                
                                TouchArea {
                                    clicked => {
                                        // TODO: Implement key binding logic
                                    }
                                }
                            }
                            
                            StylizedButton {
                                text: "Reset";
                                width: 80px;
                                height: 32px;
                                font-size: 16px;
                            }
                        }
                    }
                }
            }

			if settings-tabs.active-tab == 3 : VerticalLayout {
				padding: 40px;
				spacing: 30px;

				/*
				Account settings:

				if signed-in:
					display text: "Signed in as {username}"
					logout button

				if not signed-in:
					sign-in button
						//popup with login interface
					sign-up button
						//opens website in browser
				*/	
			}
        }
        
        // Version display
        BaseText {
            text: "Version 0.1.0"; // TODO: Make this configurable
            font-size: 16px;
            horizontal-alignment: center;
        }
    }
}

component DarkScreen inherits Rectangle {
	visible: false;
    background: #00000080;
    width: 100%;
    height: 100%;
}

global GlobalSettings {
	in-out property <Settings> settings;
}

export component MainWindow inherits Window {
	width: 1920px;
	height: 1080px;
    title: "Setback";
	icon: @image-url("../assets/images/cardsIcon.png");

	init => {
		GlobalSettings.settings = load_settings();
	}

	in-out property <ErrorLocation> error_location: ErrorLocation.None;
	in-out property <string> error_message;
	in-out property <SceneType> scene: SceneType.MainMenu;
	in-out property <HostType> host: HostType.None;
	// in property <[Player]> players: [];	//Use this for production
	in-out property <[Player]> players:[	//use this for slint preview
		{username: "Player 1 (Me)", is_human: true, team: 0, local: true, x: 0px, y: 328.125px},
		{username: "Player 2", is_human: false, team: 1, local: false, x: -371.231px, y: 232.091px},
		{username: "Player 3", is_human: false, team: 0, local: false, x: -525px, y: 0px},
        {username: "Player 4", is_human: false, team: 1, local: false, x: -371.231px, y: -232.091px},
        {username: "Player 5", is_human: false, team: 0, local: false, x: 0px, y: -328.125px},
        {username: "Player 6", is_human: false, team: 1, local: false, x: 371.231px, y: -232.091px},
        {username: "Player 7", is_human: false, team: 0, local: false, x: 525px, y: 0px},
        {username: "Player 8", is_human: false, team: 1, local: false, x: 371.231px, y: 232.091px}
	];
	// in property <[Game]> games: [];	//Use this for production
	in-out property <[Game]> games:[	//use this for slint preview
		{join_code: "123456", players: 2, max_players: 4, std_team: true, win_by_2: true, negative_scores: false, dealer_override: true},
		{join_code: "123457", players: 2, max_players: 4, std_team: true, win_by_2: true, negative_scores: false, dealer_override: true},
		{join_code: "123458", players: 2, max_players: 4, std_team: true, win_by_2: true, negative_scores: false, dealer_override: true},
		{join_code: "123459", players: 2, max_players: 4, std_team: true, win_by_2: true, negative_scores: false, dealer_override: true}
	];
	in-out property <bool> std_team_mode: true;
	in-out property <bool> win_by_2: false;
	in-out property <bool> negative_scores: true;
	in-out property <bool> dealer_override: false;
	in-out property <int> max_score: 21;
	in-out property <int> max_players: 8;

	callback exit();
	callback multiplayer_clicked();
	callback handle_credentials(username: string, password: string);
	callback save_settings(settings: Settings);
	callback load_settings() -> Settings;

	callback set_state(scene: SceneType, host: HostType);
	callback add_player();
	callback remove_player(index: int);
	callback set_player_team(index: int, team: int);
	callback make_bid(bid: int);
	callback play_card(card: Card);

	callback create_game(public: bool);
	callback join_game(join_code: string);
	callback search_games(
		max_score_cmp: Comparison,
		max_score_value: int,
		max_players_cmp: Comparison,
		max_players_value: int,
		std_team_mode: bool,
		win_by_2: bool,
		negative_scores: bool,
		dealer_override: bool
	);
	callback send_game_meta(
		std_team_mode: bool,
		win_by_2: bool,
		negative_scores: bool,
		dealer_override: bool,
		max_score: int,
		max_players: int
	);
	callback ready_up(is_ready: bool);
	callback logout();
	callback set_player_type(index: int, human: bool);

	// Main Menu Scene
	if root.scene == SceneType.MainMenu : Rectangle {
		width: 100%;
		height: 100%;
		background: Palette.Green;

		// Title and Logo
		VerticalLayout {
			y: 75px;
			spacing: 10px;
			alignment: start;

			BaseText {
				text: "Setback";
				font-size: 200px;
				horizontal-alignment: center;
			}

			Image {
				source: @image-url("../assets/images/cardsIcon.png");
				height: 128px;
				horizontal-alignment: center;
			}
		}

		// Menu Buttons
		VerticalLayout {
			y: 175px;
			spacing: 25px;
			alignment: center;
			width: 450px;

			singleplayer := StylizedButton {
				text: "Singleplayer";
				font-size: 42px;
				clicked => {
					root.scene = SceneType.Setup;
					root.host = HostType.SingleplayerSetup;
					root.set_state(root.scene, root.host);
				}
			}

			multiplayer := StylizedButton {
				text: "Multiplayer";
				font-size: 42px;
				clicked => {
					multiplayer-popup.show();
					darkScreenMainMenu.visible = true;
				}
			}

			settings := StylizedButton {
				text: "Settings";
				font-size: 42px;
				clicked => {
					root.scene = SceneType.Settings;
					root.set_state(root.scene, root.host);
				}
			}

			exit := StylizedButton {
				text: "Exit";
				font-size: 42px;
				clicked => { root.exit(); }
			}
		}

		// Multiplayer Popup
		darkScreenMainMenu := DarkScreen {}
		multiplayer-popup := PopupWindow {
			width: 600px;
			height: 600px;
			x: 715px;
			y: (parent.height - self.height) / 2;
			close-policy: no-auto-close;

			Rectangle {
				width: 100%;
				height: 100%;
				background: Palette.Green;
				border-color: Palette.Gray;
				border-width: 10px;
				border-radius: 16px;

				// Main Options
				options := VerticalLayout {
					padding: 20px;
					spacing: 80px;
					alignment: center;
					width: parent.width;

					StylizedButton {
						text: "Create Public Game";
						font-size: 32px;
						width: 450px;
						clicked => {
							root.scene = SceneType.Setup;
							root.host = HostType.Host;
							root.set_state(root.scene, root.host);
							multiplayer-popup.close();
							darkScreenMainMenu.visible = false;
						}
					}

					StylizedButton {
						text: "Create Private Game";
						font-size: 32px;
						width: 450px;
						clicked => {
							root.scene = SceneType.Setup;
							root.host = HostType.Host;
							root.set_state(root.scene, root.host);
							multiplayer-popup.close();
							darkScreenMainMenu.visible = false;
						}
					}

					StylizedButton {
						text: "Join With Code";
						font-size: 32px;
						width: 450px;
						clicked => {
							options.visible = false;
							join.visible = true;
						}
					}

					StylizedButton {
						text: "Search Public Games";
						font-size: 32px;
						width: 450px;
						clicked => {
							root.scene = SceneType.Multiplayer;
							root.set_state(root.scene, root.host);
							multiplayer-popup.close();
							darkScreenMainMenu.visible = false;
						}
					}

					StylizedButton {
						text: "Close";
						font-size: 32px;
						width: 450px;
						clicked => {
							multiplayer-popup.close();
							darkScreenMainMenu.visible = false;
						}
					}
				}

				// Join Game Interface
				join := VerticalLayout {
					visible: false;
					spacing: 80px;
					alignment: center;
					padding: 40px;
					width: parent.width;

					Rectangle {
						width: 500px;
						height: 80px;
						border-width: 5px;
						border-color: Palette.Gray;
						border-radius: 8px;
						background: white.darker(0.1);

						preview := BaseText {
							text: "Enter game code...";
							font-size: 24px;
							vertical-alignment: center;
							x: 15px;
							opacity: input.text == "" ? 0.5 : 0;
						}

						input := TextInput {
							width: 100%;
							height: 100%;
							horizontal-alignment: center;
							vertical-alignment: center;
							font-size: 32px;
							color: Palette.Orange;
						}
					}

					StylizedButton {
						text: "Join";
						font-size: 32px;
						width: 450px;
						enabled: input.text != "";
						clicked => {
							join.visible = false;
							options.visible = true;
							root.join_game(input.text);
							multiplayer-popup.close();
							root.host = HostType.Client;
							root.set_state(root.scene, root.host);
						}
					}

					StylizedButton {
						text: "Back";
						font-size: 32px;
						width: 450px;
						clicked => {
							join.visible = false;
							options.visible = true;
						}
					}
				}
			}
		}

		//error popup
		init => {
			if root.error_location == ErrorLocation.MainMenu {
				error-popup.show();
			}
		}

		error-popup := PopupWindow {
			width: 600px;
			height: 200px;
			x: (parent.width) / 2 - 220px;
			y: (parent.height - self.height) / 2;
			close-policy: no-auto-close;

			Rectangle {
				background: Palette.Green;
				border-radius: 16px;
				border-width: 2px;
				border-color: Palette.Gray;

				VerticalLayout {
					spacing: 20px;
					alignment: center;
					padding: 20px;

					BaseText {
						text: root.error_message;
						font-size: 24px;
						horizontal-alignment: center;
						vertical-alignment: center;
						wrap: true;
						width: 400px;
						height: 150px;
					}

					StylizedButton {
						text: "OK";
						font-size: 24px;
						width: 100px;
						height: 40px;
						clicked => {
							root.error_location = ErrorLocation.None;
							root.error_message = "";
							error-popup.close();
						}
					}
				}
			}
		}
	}

	//Setup
	if root.scene == SceneType.Setup : Rectangle {
		width: 100%;
		height: 100%;
		background: Palette.Green;

		// Back button with confirmation
		StylizedButton {
			text: "Back";
			width: 150px;
			height: 50px;
			x: 25px;
			y: 25px;
			font-size: 24px;
			clicked => {
				confirmLeave.show();
			}
		}

		// Leave confirmation popup
		confirmLeave := PopupWindow {
			callback confirmed;
			
			width: 600px;
			height: 200px;
			x: 100px;
			y: 100px;
			close-policy: close-on-click-outside;
			
			Rectangle {
				width: 100%;
				height: 100%;
				background: Palette.Green;
				border-radius: 16px;
				border-width: 2px;
				border-color: Palette.Gray;
				
				VerticalLayout {
					padding: 20px;
					spacing: 20px;
					
					BaseText {
						text: "Are you sure you want to leave the game setup?";
						font-size: 24px;
						horizontal-alignment: center;
						wrap: true;
					}
					
					HorizontalLayout {
						alignment: space-around;
						
						StylizedButton {
							text: "Yes";
							width: 120px;
							height: 40px;
							font-size: 20px;
							clicked => { 
								root.scene = SceneType.MainMenu;
								root.host = HostType.None;
								root.set_state(root.scene, root.host);
								confirmLeave.close();
							}
						}
						
						StylizedButton {
							text: "No";
							width: 120px;
							height: 40px;
							font-size: 20px;
							clicked => { 
								confirmLeave.close();
							}
						}
					}
				}
			}
		}

		// Player arrangement area
		if root.players.length != 0: Rectangle {
			x: 100px;
			y: 100px;
			width: parent.width - 500px;
			height: parent.height - 200px;
			
			for player[i] in root.players : PlayerDisplay {
				x: player.x + (parent.width - self.width) / 2;
				y: player.y + (parent.height - self.height) / 2;
				
				username: player.username;
				is-human: player.is_human;
				team: player.team;
				is-local: player.local;
				is-ready: false; // TODO: Add ready state to Player struct
				is-current-turn: false;
				is-setup-mode: true;
				can-edit: root.host == HostType.SingleplayerSetup || root.host == HostType.Host;
				size: 200px;
				
				remove => {
					// TODO: Implement player removal
				}
				
				team-changed(new-team) => {
					// TODO: Implement team change
				}
				
				drag-started => {
					// TODO: Implement drag start
				}
				
				drag-ended => {
					// TODO: Implement drag end
				}
				
				animate x { duration: 300ms; easing: ease; }
				animate y { duration: 300ms; easing: ease; }
			}
		}

		// Settings panel
		Rectangle {
			x: parent.width - 550px;
			y: 50px;
			width: 500px;
			height: 1000px;
			background: #18181840;
			padding: 20px;
			
			VerticalLayout {
				spacing: 20px;
				alignment: center;
				padding: 20px;
				
				BaseText {
					text: "Settings";
					font-size: 32px;
					horizontal-alignment: center;
				}
				
				// Team Mode
				HorizontalLayout {
					spacing: 10px;
					width: 350px;
					
					BaseText {
						text: "Team Mode:";
						font-size: 20px;
						vertical-alignment: center;
					}
					
					StylizedComboBox {
						width: 200px;
						height: 32px;
						choices: ["Standard", "Custom"];
						value: "Standard";
						enabled: root.host == HostType.SingleplayerSetup || root.host == HostType.Host;
					}
				}
				
				// Win by 2
				StylizedCheckbox {
					text: "Win by 2";
					checked: root.win_by_2;
					enabled: root.host == HostType.SingleplayerSetup || root.host == HostType.Host;
				}
				
				// Negative Scores
				StylizedCheckbox {
					text: "Negative Scores";
					checked: root.negative_scores;
					enabled: root.host == HostType.SingleplayerSetup || root.host == HostType.Host;
				}
				
				// Dealer Override
				StylizedCheckbox {
					text: "Dealer Override";
					checked: root.dealer_override;
					enabled: root.host == HostType.SingleplayerSetup || root.host == HostType.Host;
				}
				
				// Max Score
				HorizontalLayout {
					spacing: 10px;
					
					BaseText {
						text: "Max Score:";
						font-size: 20px;
						vertical-alignment: center;
					}
					
					StylizedSpinBox {
						value: root.max_score;
						minimum: 1;
						maximum: 99;
						enabled: root.host == HostType.SingleplayerSetup || root.host == HostType.Host;
					}
				}
				
				// Max Players
				HorizontalLayout {
					spacing: 10px;
					
					BaseText {
						text: "Max Players:";
						font-size: 20px;
						vertical-alignment: center;
					}
					
					StylizedSpinBox {
						value: root.max_players;
						minimum: 2;
						maximum: 8;
						enabled: root.host == HostType.SingleplayerSetup || root.host == HostType.Host;
					}
				}
				
				// Add Player button
				if root.host == HostType.SingleplayerSetup || root.host == HostType.Host : StylizedButton {
					text: "Add Player";
					font-size: 24px;
					clicked => {
						// TODO: Implement add player
					}
				}
				
				Rectangle { height: 20px; } // Spacer
				
				// Start/Ready button
				StylizedButton {
					text: root.host == HostType.SingleplayerSetup ? "Start" : "Ready";
					font-size: 32px;
					clicked => {
						if (root.host == HostType.SingleplayerSetup) {
							root.host = HostType.SingleplayerPlaying;
							root.scene = SceneType.Game;
							root.set_state(root.scene, root.host);
						} else {
							// TODO: Implement ready state toggle
						}
					}
				}
				
				// Countdown timer (only visible in multiplayer when all players ready)
				if root.host != HostType.SingleplayerSetup : HorizontalLayout {
					alignment: center;
					spacing: 10px;
					
					BaseText {
						text: "Starting in:";
						font-size: 24px;
						vertical-alignment: center;
					}
					
					BaseText {
						text: "10"; // TODO: Implement countdown timer
						font-size: 24px;
						vertical-alignment: center;
					}
				}
			}
		}
	}

	//Multiplayer
	if root.scene == SceneType.Multiplayer : Rectangle {
		width: 100%;
		height: 100%;
		background: Palette.Green;
		
		// Back button
		StylizedButton {
			text: "Back";
			width: 150px;
			height: 50px;
			x: 25px;
			y: 25px;
			font-size: 24px;
			clicked => {
				root.scene = SceneType.MainMenu;
				root.set_state(root.scene, root.host);
			}
		}
		
		// Main layout
		HorizontalLayout {
			padding: 80px;
			spacing: 40px;
			
			// Game list (left side)
			Rectangle {
				width: 70%;
				background: #18181840;
				border-radius: 16px;
				
				VerticalLayout {
					padding: 20px;
					spacing: 20px;
					
					// Header
					HorizontalLayout {
						height: 40px;
						
						for header in [
							{ text: "Players", width: 120px },
							{ text: "Team Mode", width: 120px },
							{ text: "Win by 2", width: 100px },
							{ text: "Neg. Scores", width: 140px },
							{ text: "Dealer Override", width: 160px },
							{ text: "", width: 100px } // Join button column
						] : Rectangle {
							width: header.width;
							
							BaseText {
								text: header.text;
								font-size: 20px;
								font-weight: 700;
								horizontal-alignment: center;
								vertical-alignment: center;
							}
						}
					}
					
					// Game list
					ScrollView {
						viewport-height: games.preferred-height;
						
						games := VerticalLayout {
							spacing: 10px;
							
							// Sample game entries (replace with actual data)
							for game in root.games : Rectangle {
								height: 50px;
								background: #ffffff20;
								border-radius: 8px;
								
								HorizontalLayout {
									padding: 10px;
									
									// Players
									Rectangle {
										width: 120px;
										BaseText {
											text: game.players + " / " + game.max_players;
											font-size: 18px;
											horizontal-alignment: center;
											vertical-alignment: center;
										}
									}
									
									// Team Mode
									Rectangle {
										width: 120px;
										BaseText {
											text: game.std_team ? "Standard" : "Custom";
											font-size: 18px;
											horizontal-alignment: center;
											vertical-alignment: center;
										}
									}
									
									// Win by 2
									Rectangle {
										width: 100px;
										Image {
											source: game.win_by_2 ? 
												@image-url("../assets/images/checkmark.png") : 
												@image-url("../assets/images/x.png");
											width: 24px;
											height: 24px;
											x: (parent.width - self.width) / 2;
											y: (parent.height - self.height) / 2;
										}
									}
									
									// Negative Scores
									Rectangle {
										width: 140px;
										Image {
											source: game.negative_scores ? 
												@image-url("../assets/images/checkmark.png") : 
												@image-url("../assets/images/x.png");
											width: 24px;
											height: 24px;
											x: (parent.width - self.width) / 2;
											y: (parent.height - self.height) / 2;
										}
									}
									
									// Dealer Override
									Rectangle {
										width: 160px;
										Image {
											source: game.dealer_override
												? @image-url("../assets/images/checkmark.png")
												: @image-url("../assets/images/x.png");
											width: 24px;
											height: 24px;
											x: (parent.width - self.width) / 2;
											y: (parent.height - self.height) / 2;
										}
									}
									
									// Join button
									StylizedButton {
										text: "Join";
										width: 80px;
										height: 30px;
										font-size: 16px;
										clicked => {
											root.join_game(game.join_code);
										}
									}
								}
							}
						}
					}
				}
			}
			
			// Filters panel (right side)
			Rectangle {
				width: 20%;
				background: #18181840;
				border-radius: 16px;
				
				VerticalLayout {
					padding: 20px;
					spacing: 20px;
					alignment: start;
					
					BaseText {
						text: "Active Filters";
						font-size: 24px;
						font-weight: 700;
						horizontal-alignment: center;
					}
					
					// Team Mode filter
					HorizontalLayout {
						spacing: 10px;

						BaseText {
							text: "Team Mode";
							font-size: 24px;
						}
						
						StylizedComboBox {
							width: 100%;
							height: 32px;
							choices: ["Standard", "Custom"];
							value: "Standard";
						}
					}
					
					// Win by 2 filter
					StylizedCheckbox {
						text: "Win by 2";
						checked: false;
					}
					
					// Negative Scores filter
					StylizedCheckbox {
						text: "Negative Scores";
						checked: false;
					}
					
					// Dealer Override filter
					StylizedCheckbox {
						text: "Dealer Override";
						checked: false;
					}
					
					// Max Score filter
					VerticalLayout {
						spacing: 10px;
						
						BaseText {
							text: "Max Score";
							font-size: 24px;
						}
						
						HorizontalLayout {
							spacing: 10px;
							
							StylizedComboBox {
								width: 20%;
								height: 32px;
								choices: ["=", "≤", "≥", "<", ">", "≠"];
								value: "=";
							}
							
							StylizedSpinBox {
								width: 20%;
								height: 30%;
								value: 21;
								minimum: 2;
								maximum: 99;
							}
						}
					}
					
					// Max Players filter
					VerticalLayout {
						spacing: 10px;
						
						BaseText {
							text: "Max Players";
							font-size: 24px;
						}
						
						HorizontalLayout {
							spacing: 10px;
							
							StylizedComboBox {
								width: 20%;
								height: 32px;
								choices: ["=", "≤", "≥", "<", ">", "≠"];
								value: "=";
							}
							
							StylizedSpinBox {
								width: 20%;
								height: 30%;
								value: 8;
								minimum: 4;
								maximum: 8;
							}
						}
					}
				}
			}
		}
	}

	//Game
	if root.scene == SceneType.Game : Rectangle {
		width: 100%;
		height: 100%;
		background: Palette.Green;
		
		// Settings button
		Rectangle {
			width: 48px;
			height: 48px;
			x: 25px;
			y: 25px;
			
			Image {
				source: @image-url("../assets/images/gear.png");
				width: parent.width;
				height: parent.height;
			}
			
			gameTouchArea := TouchArea {
				clicked => {
					darkScreenGame.visible = true;
					gameMenu.show();
				}
			}
			
			states [
				hover when gameTouchArea.has-hover: {
					gameTouchArea.mouse-cursor: pointer;
				}
			]
		}
		
		// Game information display
		HorizontalLayout {
			y: 25px;
			padding-left: 100px;
			padding-right: 100px;
			spacing: 40px;
			
			// Round number
			Rectangle {
				width: 150px;
				height: 48px;
				background: #18181840;
				border-radius: 8px;
				
				BaseText {
					text: "Round 1"; // TODO: Get from game state
					font-size: 24px;
					horizontal-alignment: center;
					vertical-alignment: center;
				}
			}
			
			// Team scores
			Rectangle {
				width: 300px;
				height: 48px;
				background: #18181840;
				border-radius: 8px;
				
				HorizontalLayout {
					padding: 10px;
					spacing: 20px;
					
					BaseText {
						text: "Team 1: 0"; // TODO: Get from game state
						font-size: 24px;
						vertical-alignment: center;
					}
					
					BaseText {
						text: "Team 2: 0"; // TODO: Get from game state
						font-size: 24px;
						vertical-alignment: center;
					}
				}
			}
			
			// Trump suit
			Rectangle {
				width: 150px;
				height: 48px;
				background: #18181840;
				border-radius: 8px;
				
				HorizontalLayout {
					padding: 10px;
					spacing: 10px;
					
					BaseText {
						text: "Trump:";
						font-size: 24px;
						vertical-alignment: center;
					}
					
					Image {
						width: 24px;
						height: 24px;
						source: @image-url("../assets/images/suits/hearts.png"); // TODO: Get from game state
						y: (parent.height - self.height) / 2;
					}
				}
			}
			
			// Lead suit
			Rectangle {
				width: 150px;
				height: 48px;
				background: #18181840;
				border-radius: 8px;
				
				HorizontalLayout {
					padding: 10px;
					spacing: 10px;
					
					BaseText {
						text: "Lead:";
						font-size: 24px;
						vertical-alignment: center;
					}
					
					Image {
						width: 24px;
						height: 24px;
						source: @image-url("../assets/images/suits/clubs.png"); // TODO: Get from game state
						y: (parent.height - self.height) / 2;
					}
				}
			}
			
			// Highest bid
			Rectangle {
				width: 150px;
				height: 48px;
				background: #18181840;
				border-radius: 8px;
				
				BaseText {
					text: "Bid: 3"; // TODO: Get from game state
					font-size: 24px;
					horizontal-alignment: center;
					vertical-alignment: center;
				}
			}
		}
		
		// Player arrangement and game area
		Rectangle {
			y: 100px;
			width: parent.width;
			height: parent.height - 100px;
			
			// Other players
			for player[i] in root.players : PlayerDisplay {
				visible: !player.local;
				x: player.x + (parent.width - self.width) / 2;
				y: player.y + (parent.height - self.height) / 2;
				
				username: player.username;
				is-human: player.is_human;
				team: player.team;
				is-local: player.local;
				is-ready: false;
				is-current-turn: false; // TODO: Get from game state
				is-setup-mode: false;
				can-edit: false;
				size: 150px;
			}
			
			// Center pile
			Rectangle {
				x: (parent.width - self.width) / 2;
				y: (parent.height - self.height) / 2;
				width: 140px;
				height: 200px;
				
				// Last played card
				Card {
					number: 10; // TODO: Get from game state
					suit: 0; // TODO: Get from game state
					face-up: true;
					enabled: false;
					width: parent.width;
				}
				
				// Pile owner label
				BaseText {
					text: "Player 2's Pile"; // TODO: Get from game state
					font-size: 20px;
					horizontal-alignment: center;
					y: parent.height + 10px;
				}
			}
			
			// Deck
			Rectangle {
				x: parent.width - self.width - 100px;
				y: (parent.height - self.height) / 2;
				width: 140px;
				height: 200px;
				
				Card {
					face-up: false;
					enabled: false;
					width: parent.width;
				}
				
				BaseText {
					text: "Deck";
					font-size: 20px;
					horizontal-alignment: center;
					y: parent.height + 10px;
				}
			}
			
			// Local player's hand
			Rectangle {
				x: (parent.width - self.width) / 2;
				y: parent.height - self.height - 50px;
				width: 600px;
				height: 200px;
				
				HorizontalLayout {
					spacing: -50px;
					
					for card[i] in [
						{number: 2, suit: 0},
						{number: 7, suit: 1},
						{number: 10, suit: 2},
						{number: 14, suit: 3},
						{number: 11, suit: 0},
						{number: 4, suit: 2}
					] : Card {
						number: card.number;
						suit: card.suit;
						face-up: true;
						enabled: true;
						draggable: true;
						width: 140px;
						
						clicked => {
							// TODO: Handle card click
						}
						
						drag-started => {
							// TODO: Handle drag start
						}
						
						drag-ended => {
							// TODO: Handle drag end
						}
					}
				}
			}
		}
		
		// Bid prompt overlay
		Rectangle {
			visible: false; // TODO: Show when bidding
			background: #00000080;
			width: 100%;
			height: 100%;
			
			VerticalLayout {
				padding: 200px;
				spacing: 40px;
				
				BaseText {
					text: "Make Your Bid";
					font-size: 48px;
					horizontal-alignment: center;
				}
				
				HorizontalLayout {
					alignment: center;
					spacing: 20px;
					
					for bid in [0, 2, 3, 4, 5] : StylizedButton {
						text: bid == 0 ? "Pass" : bid;
						width: 100px;
						height: 60px;
						font-size: 32px;
						enabled: bid == 0 || bid > 3; // TODO: Check against highest bid
						clicked => {
							root.make_bid(bid);
						}
					}
				}
			}
		}
		
		// Round summary overlay
		Rectangle {
			visible: false; // TODO: Show at end of round
			background: #00000080;
			width: 100%;
			height: 100%;
			
			Rectangle {
				width: 600px;
				height: 400px;
				background: Palette.Green;
				border-radius: 16px;
				border-width: 2px;
				border-color: Palette.Gray;
				
				VerticalLayout {
					padding: 40px;
					spacing: 20px;
					
					BaseText {
						text: "Round Summary";
						font-size: 32px;
						horizontal-alignment: center;
					}
					
					for score in [
						{type: "High", team: 1},
						{type: "Low", team: 2},
						{type: "Jack", team: 1},
						{type: "Game", points: 3, team: 2}
					] : BaseText {
						text: score.type + (score.type == "Game" ? 
							" (" + score.points + " points)" : "") + 
							" - Team " + score.team;
						font-size: 24px;
						horizontal-alignment: center;
					}
					
					StylizedButton {
						text: "Continue";
						width: 200px;
						height: 50px;
						font-size: 24px;
						clicked => {
							// TODO: Hide summary
						}
					}
				}
			}
		}
		
		// Game menu overlay
		darkScreenGame := DarkScreen {
			visible: false;
		}
		
		gameMenu := PopupWindow {
			width: 400px;
			height: 500px;
			x: (parent.width - self.width) / 2;
			y: (parent.height - self.height) / 2;
			close-policy: close-on-click-outside;

			Rectangle {
				background: Palette.Green;
				border-radius: 16px;
				border-width: 2px;
				border-color: Palette.Gray;

				VerticalLayout {
					padding: 40px;
					spacing: 20px;

					StylizedButton {
						text: "Settings";
						font-size: 24px;
						clicked => {
							settings-popup.show();
						}
					}
					
					StylizedButton {
						text: "Leave Game";
						font-size: 24px;
						clicked => {
							leave-game-dialog.visible = true;
						}
					}
					
					StylizedButton {
						text: "Resume";
						font-size: 24px;
						clicked => {
							darkScreenGame.visible = false;
							gameMenu.close();
						}
					}
				}
			}
		}
		
		// Settings popup
		settings-popup := PopupWindow {
			x: (parent.width - 800px) / 2;
			y: (parent.height - 600px) / 2;
			width: 800px;
			height: 600px;
			close-policy: close-on-click-outside;

			Rectangle {
				background: Palette.Green;
				border-radius: 16px;
				border-width: 2px;
				border-color: Palette.Gray;

				SettingsPanel {
					show-back-button: true;
					back => {
						settings-popup.close();
					}
				}
			}
		}

		// Leave game confirmation dialog
		leave-game-dialog := ConfirmationDialog {
			message: "Are you sure you want to leave the game?";
			
			confirmed => {
				root.scene = SceneType.MainMenu;
				root.host = HostType.None;
				root.set_state(root.scene, root.host);
				darkScreenGame.visible = false;
				gameMenu.close();
			}
		}
	}

	//Settings
	if root.scene == SceneType.Settings : Rectangle {
		width: 100%;
		height: 100%;
		background: Palette.Green;

		StylizedButton {
			text: "Back";
			width: 150px;
			height: 50px;
			x: 25px;
			y: 25px;
			font-size: 24px;
			clicked => {
				root.scene = SceneType.MainMenu;
				root.set_state(root.scene, root.host);
			}
		}

		Rectangle {
			width: 100%;
			height: 90%;
			y: 100px;
			
			SettingsPanel {
				width: 100%;
				height: 100%;
			}
		}
	}
}