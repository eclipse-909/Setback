import {SpinBox,Slider} from "std-widgets.slint";

///Game state which stores what scene is currently active.
export enum SceneType {
	MainMenu,
	Setup,
	Multiplayer,
	Game,
	Settings
}

enum PlayerType {
	Human,
	AI
}

enum HostType {
	///Not in a game.
	None,
	SingleplayerSetup,
	SingleplayerPlaying,
	///Created a multiplayer game as the host.
	Host,
	///Joined a multiplayer game as a client.
	Client
}

export struct Player {
	username: string,
	player_type: PlayerType,
	team: int,
	local: bool
}

enum Suit {
	Hearts,
	Clubs,
	Diamonds,
	Spades
}

struct Card {
	suit: Suit,
	number: int
}

enum Comparison {
	Equal,
	LessOrEqual,
	GreaterOrEqual,
	Less,
	Greater,
	NotEqual
}

struct GameFilter {
    max_score_cmp: Comparison,
    max_players_cmp: Comparison,
    max_score_value: int,
    max_players_value: int,
	std_team_mode: bool,
    win_by_2: bool,
    negative_scores: bool,
    dealer_override: bool
}

global Palette {
	out property <color> Green: #04F06A;
	out property <color> Blue: #2F52E0;
	out property <color> Yellow: #F9CB40;
	out property <color> Orange: #FF715B;
	out property <color> Gray: #4C5B5C;
}

export global GameState {
	in property <SceneType> scene: SceneType.MainMenu;
	in property <HostType> host: HostType.None;
//	in property <[Player]> players;//TODO swap back after doing the preview
	in property <[Player]> players: [
		{username: "Player 1 (me)", player_type: PlayerType.Human, team: 0, human: true, local: true},
		{username: "Player 2", player_type: PlayerType.AI, team: 1, human: false, local: false},
		{username: "Player 3", player_type: PlayerType.AI, team: 0, human: false, local: false},
        {username: "Player 4", player_type: PlayerType.AI, team: 1, human: false, local: false},
        {username: "Player 5", player_type: PlayerType.AI, team: 0, human: false, local: false},
        {username: "Player 6", player_type: PlayerType.AI, team: 1, human: false, local: false},
        {username: "Player 7", player_type: PlayerType.AI, team: 0, human: false, local: false},
        {username: "Player 8", player_type: PlayerType.AI, team: 1, human: false, local: false}
	];

	callback exit();

	callback bid(int);
	callback play_card(Card);

	callback send_create_game();
	callback send_join(string);
	callback send_search_games(GameFilter);
	callback send_game_meta();//TODO find out how to pass complex values
	callback send_player(Player);
	callback send_players([Player]);
	callback send_ready(bool);

	callback logout();
	callback get_account();

	callback fetch_players() -> [Player];
	callback fetch_games();

	callback calc_player_pos(int) -> {x: length, y: length};
}

component MenuButton inherits TouchArea {
	in property <string> label;
	in property <float> fontScale: 1;

	width: 450px;

	btnLabel := Text {
		text: label;
		font-size: fontScale * 10px;
		font-weight: 900;
		color: Palette.Orange;
		stroke: Palette.Gray;
		stroke-width: fontScale * 1px;
		horizontal-alignment: center;

		animate color { duration: 32ms; }
	}

	states [
		pressed when root.pressed: {
			btnLabel.color: Palette.Orange.darker(0.4);
		}
		hover when root.has-hover: {
			btnLabel.color: Palette.Orange.darker(0.2);
			root.mouse-cursor: pointer;
		}
	]
}

component CheckBox inherits HorizontalLayout {
	in property <string> text;
	in property <bool> enabled;
	in-out property <bool> checked;
	in property <int> scale: 1;

	callback toggled(bool);

	spacing: 10px;
	alignment: start;

	checkBG := Rectangle {
		background: #18181840;
		width: scale * 20px;
		height: scale * 20px;
		border-width: 4px;
		border-color: Palette.Orange;
		border-radius: 10px;

		touchArea := TouchArea {
			width: scale * 20px;
            height: scale * 20px;

			checkmark := Image {
				source: @image-url("../assets/images/checkmark.png");
				image-fit: contain;
				width: scale * 15px;
                height: scale * 15px;
			}

			clicked => {
				root.checked = !root.checked;
				root.toggled(root.checked);
			}
		}

		animate background { duration: 32ms; }

		states [
            hover when touchArea.has-hover: {
                checkBG.background: #18181880;
                touchArea.mouse-cursor: pointer;
            }
            pressed when touchArea.pressed: {
                checkBG.background: #181818c0;
                touchArea.mouse-cursor: pointer;
            }
        ]
	}

	Text {
		text: root.text;
		font-size: scale * 10px;
        font-weight: 900;
        color: Palette.Orange;
        stroke: Palette.Gray;
        stroke-width: scale * 1px;
        vertical-alignment: center;
	}

	states [
        checked when self.checked: {
            checkmark.visible: true;
        }
        unchecked when !self.checked: {
            checkmark.visible: false;
        }
    ]
}

component SetupPlayer inherits HorizontalLayout {
	in property <string> username;
	in property <bool> human;
	in property <int> team;
	in property <bool> humanVisible;
	in property <bool> teamVisible;

    height: 256px;

	touchArea := TouchArea {
		width: 256px;
        height: 256px;

		Image {
			width: 256px;
			height: 256px;
			source: root.human ? @image-url("../assets/images/personIcon.png") : @image-url("../assets/images/botIcon.png");
			colorize: #000000;
			image-fit: contain;
		}

		states [
			pressed when self.pressed: {
				touchArea.mouse-cursor: grabbing;
			}
			hover when self.has-hover: {
				touchArea.mouse-cursor: grab;
			}
		]
	}

	VerticalLayout {
		alignment: start;
		spacing: 10px;

		xBG := Rectangle {
            background: #18181840;
            width: 30px;
            height: 30px;
            border-width: 4px;
            border-color: Palette.Orange;
            border-radius: 10px;

            xTouchArea := TouchArea {
                width: 30px;
                height: 30px;

                checkmark := Image {
                    source: @image-url("../assets/images/x.png");
                    image-fit: contain;
                    width: 18px;
                    height: 18px;
                }

                clicked => {
                    //TODO delete this player
                }
            }

            animate background { duration: 32ms; }

            states [
                hover when xTouchArea.has-hover: {
                    xBG.background: #18181880;
                    xTouchArea.mouse-cursor: pointer;
                }
                pressed when xTouchArea.pressed: {
                    xBG.background: #181818c0;
                    xTouchArea.mouse-cursor: pointer;
                }
            ]
        }
		Text {
			text: username;
			font-size: 20px;
            font-weight: 900;
            color: Palette.Orange;
            stroke: Palette.Gray;
            stroke-width: 2px;
		}
		if humanVisible: CheckBox {
			text: "Human";
			enabled: human;
			scale: 2;
		}
		HorizontalLayout {
			Text {
				text: "Team Number:";
				font-size: 20px;
                font-weight: 900;
                color: Palette.Orange;
                stroke: Palette.Gray;
                stroke-width: 2px;
			}
			if teamVisible: SpinBox {//TODO reimplement SpinBox
				value: team;
				minimum: 0;
				maximum: 7;
			}
		}
	}
}

