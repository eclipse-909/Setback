	                    vertical-alignment: center;
	                    horizontal-alignment: left;
	                }
	                slider := Slider {
	                    value: 21;
	                    minimum: 4;
	                    maximum: 64;
	                }
	            }
	            MenuButton {
	                label: "Add Player";
	                fontScale: 4;

	                clicked => {
	                    //TODO add a player
	                }
	            }
			}
        }

        init => {
//			GameState.players = GameState.fetch_players();//TODO uncomment after preview
        }

		for player[index] in GameState.players: SetupPlayer {
			username: player.username;
			human: player.player_type == PlayerType.Human;
			team: player.team;
			humanVisible: GameState.host != HostType.SingleplayerSetup && !player.local;
			//TODO

			animate x {
				duration: 32ms;
				easing: ease-out-expo;
			}
		}

//		callback calc_player_pos(int) -> {x: length, y: length};

		function calc_player_pos(index: int) {

		}
