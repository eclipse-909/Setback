		//TODO Game
		//table
		//players
		//cards, deck, hands, pile
		//bid selection menu
		//card selection menu (or drag and drop cards onto pile?)
		//settings menu - with close button
	}

	//Settings
	if GameState.scene == SceneType.Settings : Rectangle {
		width: 100%;
		height: 100%;
		background: Palette.Green;

		BackButton {
            goto_scene: SceneType.MainMenu;
        }

		Settings {}
