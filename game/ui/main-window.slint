component DarkScreen inherits Rectangle {
	visible: false;
    background: #00000080;
    width: 100%;
    height: 100%;
}

export component MainWindow inherits Window {
	width: 1920px;
	height: 1080px;
    title: "Setback";
	icon: @image-url("../assets/images/cardsIcon.png");

	// Dropdown overlay properties
	property <bool> active-dropdown-overlay: false;
	property <length> dropdown-x;
	property <length> dropdown-y;
	property <length> dropdown-width;
	property <[string]> dropdown-choices;
	callback dropdown-callback(string);

	// Main Menu Scene
	if GameState.scene == SceneType.MainMenu : Rectangle {
		width: 100%;
		height: 100%;
		background: Palette.Green;

		// Title and Logo
		VerticalLayout {
			y: 75px;
			spacing: 10px;
			alignment: start;

			BaseText {
				text: "Setback";
				font-size: 200px;
				horizontal-alignment: center;
			}

			Image {
				source: @image-url("../assets/images/cardsIcon.png");
				height: 128px;
				horizontal-alignment: center;
			}
		}

		// Menu Buttons
		VerticalLayout {
			y: 175px;
			spacing: 25px;
			alignment: center;
			width: 450px;

			singleplayer := StylizedButton {
				text: "Singleplayer";
				font-size: 42px;
				clicked => {
					GameState.scene = SceneType.Setup;
					GameState.host = HostType.SingleplayerSetup;
				}
			}

			multiplayer := StylizedButton {
				text: "Multiplayer";
				font-size: 42px;
				clicked => {
					multiplayer-popup.show();
				}
			}

			settings := StylizedButton {
				text: "Settings";
				font-size: 42px;
				clicked => { GameState.scene = SceneType.Settings; }
			}

			exit := StylizedButton {
				text: "Exit";
				font-size: 42px;
				clicked => { GameState.exit(); }
			}
		}

		// Multiplayer Popup
		darkScreenMainMenu := DarkScreen {}

		multiplayer-popup := PopupWindow {
			width: 600px;
			height: 600px;
			x: 715px;
			y: (parent.height - self.height) / 2;
			close-policy: close-on-click-outside;

			Rectangle {
				width: 100%;
				height: 100%;
				background: Palette.Green;
				border-color: Palette.Gray;
				border-width: 10px;
				border-radius: 16px;

				// Main Options
				options := VerticalLayout {
					padding: 20px;
					spacing: 80px;
					alignment: center;
					width: parent.width;

					StylizedButton {
						text: "Create Game";
						font-size: 32px;
						width: 450px;
						clicked => {
							options.visible = false;
							singleplayer.enabled = false;
							multiplayer.enabled = false;
							settings.enabled = false;
							exit.enabled = false;
							GameState.scene = SceneType.Setup;
							GameState.host = HostType.Host;
							multiplayer-popup.close();
						}
					}

					StylizedButton {
						text: "Join With Code";
						font-size: 32px;
						width: 450px;
						clicked => {
							options.visible = false;
							join.visible = true;
							singleplayer.enabled = false;
							multiplayer.enabled = false;
							settings.enabled = false;
							exit.enabled = false;
						}
					}

					StylizedButton {
						text: "Search Games";
						font-size: 32px;
						width: 450px;
						clicked => {
							GameState.scene = SceneType.Multiplayer;
							multiplayer-popup.close();
						}
					}

					StylizedButton {
						text: "Close";
						font-size: 32px;
						width: 450px;
						clicked => {
							multiplayer-popup.close();
							singleplayer.enabled = true;
							multiplayer.enabled = true;
							settings.enabled = true;
							exit.enabled = true;
						}
					}
				}

				// Join Game Interface
				join := VerticalLayout {
					visible: false;
					spacing: 80px;
					alignment: center;
					padding: 40px;
					width: parent.width;

					Rectangle {
						width: 500px;
						height: 80px;
						border-width: 5px;
						border-color: Palette.Gray;
						border-radius: 8px;
						background: white.darker(0.1);

						preview := BaseText {
							text: "Enter game code...";
							font-size: 24px;
							vertical-alignment: center;
							x: 15px;
							opacity: input.text == "" ? 0.5 : 0;
						}

						input := TextInput {
							width: 100%;
							height: 100%;
							horizontal-alignment: center;
							vertical-alignment: center;
							font-size: 32px;
							color: Palette.Orange;
						}
					}

					StylizedButton {
						text: "Join";
						font-size: 32px;
						width: 450px;
						enabled: input.text != "";
						clicked => {
							GameState.send_join(input.text);
							multiplayer-popup.close();
							singleplayer.enabled = true;
							multiplayer.enabled = true;
							settings.enabled = true;
							exit.enabled = true;
							GameState.host = HostType.Client;
						}
					}

					StylizedButton {
						text: "Back";
						font-size: 32px;
						width: 450px;
						clicked => {
							join.visible = false;
							options.visible = true;
						}
					}
				}
			}
		}
	}

	//Setup
	if GameState.scene == SceneType.Setup : Rectangle {
		width: 100%;
		height: 100%;
		background: Palette.Green;

		// Back button with confirmation
		StylizedButton {
			text: "Back";
			width: 150px;
			height: 50px;
			x: 25px;
			y: 25px;
			font-size: 24px;
			clicked => {
				confirmLeave.show();
			}
		}

		// Leave confirmation popup
		confirmLeave := PopupWindow {
			callback confirmed;
			
			width: 600px;
			height: 200px;
			x: 100px;
			y: 100px;
			close-policy: close-on-click-outside;
			
			Rectangle {
				width: 100%;
				height: 100%;
				background: Palette.Green;
				border-radius: 16px;
				border-width: 2px;
				border-color: Palette.Gray;
				
				VerticalLayout {
					padding: 20px;
					spacing: 20px;
					
					BaseText {
						text: "Are you sure you want to leave the game setup?";
						font-size: 24px;
						horizontal-alignment: center;
						wrap: true;
					}
					
					HorizontalLayout {
						alignment: space-around;
						
						StylizedButton {
							text: "Yes";
							width: 120px;
							height: 40px;
							font-size: 20px;
							clicked => { 
								GameState.scene = SceneType.MainMenu;
								GameState.host = HostType.None;
								confirmLeave.close();
							}
						}
						
						StylizedButton {
							text: "No";
							width: 120px;
							height: 40px;
							font-size: 20px;
							clicked => { 
								confirmLeave.close();
							}
						}
					}
				}
			}
		}

		// Player arrangement area
		Rectangle {
			x: 100px;
			y: 100px;
			width: parent.width - 500px;
			height: parent.height - 200px;
			
			for player[i] in GameState.players : PlayerDisplay {
				property <{x: length, y: length}> pos: GameState.calc_player_pos(i);
				x: pos.x + (parent.width - self.width) / 2;
				y: pos.y + (parent.height - self.height) / 2;
				
				username: player.username;
				is-human: player.player_type == PlayerType.Human;
				team: player.team;
				is-local: player.local;
				is-ready: false; // TODO: Add ready state to Player struct
				is-current-turn: false;
				is-setup-mode: true;
				can-edit: GameState.host == HostType.SingleplayerSetup || GameState.host == HostType.Host;
				size: 200px;
				
				remove => {
					// TODO: Implement player removal
				}
				
				team-changed(new-team) => {
					// TODO: Implement team change
				}
				
				drag-started => {
					// TODO: Implement drag start
				}
				
				drag-ended => {
					// TODO: Implement drag end
				}
				
				animate x { duration: 300ms; easing: ease; }
				animate y { duration: 300ms; easing: ease; }
			}
		}

		// Settings panel
		Rectangle {
			x: parent.width - 450px;
			width: 400px;
			height: parent.height;
			background: #18181840;
			padding: 20px;
			
			VerticalLayout {
				spacing: 20px;
				
				BaseText {
					text: "Settings";
					font-size: 32px;
					horizontal-alignment: center;
				}
				
				// Team Mode
				HorizontalLayout {
					spacing: 10px;
					
					BaseText {
						text: "Team Mode:";
						font-size: 20px;
						vertical-alignment: center;
					}
					
					StylizedComboBox {
						width: 200px;
						height: 32px;
						choices: ["Standard", "Custom"];
						value: "Standard";
						enabled: GameState.host == HostType.SingleplayerSetup || GameState.host == HostType.Host;
					}
				}
				
				// Win by 2
				StylizedCheckbox {
					text: "Win by 2";
					checked: false;
					enabled: GameState.host == HostType.SingleplayerSetup || GameState.host == HostType.Host;
				}
				
				// Negative Scores
				StylizedCheckbox {
					text: "Negative Scores";
					checked: false;
					enabled: GameState.host == HostType.SingleplayerSetup || GameState.host == HostType.Host;
				}
				
				// Dealer Override
				StylizedCheckbox {
					text: "Dealer Override";
					checked: false;
					enabled: GameState.host == HostType.SingleplayerSetup || GameState.host == HostType.Host;
				}
				
				// Max Score
				HorizontalLayout {
					spacing: 10px;
					
					BaseText {
						text: "Max Score:";
						font-size: 20px;
						vertical-alignment: center;
					}
					
					StylizedSpinBox {
						value: 11;
						minimum: 1;
						maximum: 99;
						enabled: GameState.host == HostType.SingleplayerSetup || GameState.host == HostType.Host;
					}
				}
				
				// Max Players
				HorizontalLayout {
					spacing: 10px;
					
					BaseText {
						text: "Max Players:";
						font-size: 20px;
						vertical-alignment: center;
					}
					
					StylizedSpinBox {
						value: 4;
						minimum: 2;
						maximum: 8;
						enabled: GameState.host == HostType.SingleplayerSetup || GameState.host == HostType.Host;
					}
				}
				
				// Add Player button
				if GameState.host == HostType.SingleplayerSetup || GameState.host == HostType.Host : StylizedButton {
					text: "Add Player";
					font-size: 24px;
					clicked => {
						// TODO: Implement add player
					}
				}
				
				Rectangle { height: 20px; } // Spacer
				
				// Start/Ready button
				StylizedButton {
					text: GameState.host == HostType.SingleplayerSetup ? "Start" : "Ready";
					font-size: 32px;
					clicked => {
						if (GameState.host == HostType.SingleplayerSetup) {
							GameState.host = HostType.SingleplayerPlaying;
							GameState.scene = SceneType.Game;
						} else {
							// TODO: Implement ready state toggle
						}
					}
				}
				
				// Countdown timer (only visible in multiplayer when all players ready)
				if GameState.host != HostType.SingleplayerSetup : HorizontalLayout {
					alignment: center;
					spacing: 10px;
					
					BaseText {
						text: "Starting in:";
						font-size: 24px;
						vertical-alignment: center;
					}
					
					BaseText {
						text: "10"; // TODO: Implement countdown timer
						font-size: 24px;
						vertical-alignment: center;
					}
				}
			}
		}
	}

	//Multiplayer
	if GameState.scene == SceneType.Multiplayer : Rectangle {
		width: 100%;
		height: 100%;
		background: Palette.Green;
		
		// Back button
		StylizedButton {
			text: "Back";
			width: 150px;
			height: 50px;
			x: 25px;
			y: 25px;
			font-size: 24px;
			clicked => {
				GameState.scene = SceneType.MainMenu;
			}
		}
		
		// Main layout
		HorizontalLayout {
			padding: 80px;
			spacing: 40px;
			
			// Game list (left side)
			Rectangle {
				width: 70%;
				background: #18181840;
				border-radius: 16px;
				
				VerticalLayout {
					padding: 20px;
					spacing: 20px;
					
					// Header
					HorizontalLayout {
						height: 40px;
						
						for header in [
							{ text: "Players", width: 120px },
							{ text: "Team Mode", width: 120px },
							{ text: "Win by 2", width: 100px },
							{ text: "Neg. Scores", width: 120px },
							{ text: "Dealer Override", width: 140px },
							{ text: "", width: 100px } // Join button column
						] : Rectangle {
							width: header.width;
							
							BaseText {
								text: header.text;
								font-size: 20px;
								font-weight: 700;
								horizontal-alignment: center;
								vertical-alignment: center;
							}
						}
					}
					
					// Game list
					ScrollView {
						viewport-height: games.preferred-height;
						
						games := VerticalLayout {
							spacing: 10px;
							
							// Sample game entries (replace with actual data)
							for game in [
								{
									players: "2/4",
									team-mode: "Standard",
									win-by-2: true,
									neg-scores: false,
									dealer-override: true
								},
								{
									players: "3/6",
									team-mode: "Custom",
									win-by-2: false,
									neg-scores: true,
									dealer-override: false
								}
							] : Rectangle {
								height: 50px;
								background: #ffffff20;
								border-radius: 8px;
								
								HorizontalLayout {
									padding: 10px;
									
									// Players
									Rectangle {
										width: 120px;
										BaseText {
											text: game.players;
											font-size: 18px;
											horizontal-alignment: center;
											vertical-alignment: center;
										}
									}
									
									// Team Mode
									Rectangle {
										width: 120px;
										BaseText {
											text: game.team-mode;
											font-size: 18px;
											horizontal-alignment: center;
											vertical-alignment: center;
										}
									}
									
									// Win by 2
									Rectangle {
										width: 100px;
										Image {
											source: game.win-by-2 ? 
												@image-url("../assets/images/checkmark.png") : 
												@image-url("../assets/images/x.png");
											width: 24px;
											height: 24px;
											x: (parent.width - self.width) / 2;
											y: (parent.height - self.height) / 2;
										}
									}
									
									// Negative Scores
									Rectangle {
										width: 120px;
										Image {
											source: game.neg-scores ? 
												@image-url("../assets/images/checkmark.png") : 
												@image-url("../assets/images/x.png");
											width: 24px;
											height: 24px;
											x: (parent.width - self.width) / 2;
											y: (parent.height - self.height) / 2;
										}
									}
									
									// Dealer Override
									Rectangle {
										width: 140px;
										Image {
											source: game.dealer-override ? 
												@image-url("../assets/images/checkmark.png") : 
												@image-url("../assets/images/x.png");
											width: 24px;
											height: 24px;
											x: (parent.width - self.width) / 2;
											y: (parent.height - self.height) / 2;
										}
									}
									
									// Join button
									StylizedButton {
										text: "Join";
										width: 80px;
										height: 30px;
										font-size: 16px;
										clicked => {
											GameState.scene = SceneType.Setup;
											GameState.host = HostType.Client;
										}
									}
								}
							}
						}
					}
				}
			}
			
			// Filters panel (right side)
			Rectangle {
				width: 30%;
				background: #18181840;
				border-radius: 16px;
				
				VerticalLayout {
					padding: 20px;
					spacing: 20px;
					
					BaseText {
						text: "Active Filters";
						font-size: 24px;
						font-weight: 700;
						horizontal-alignment: center;
					}
					
					// Team Mode filter
					VerticalLayout {
						spacing: 10px;
						
						StylizedCheckbox {
							text: "Team Mode";
							checked: false;
						}
						
						StylizedComboBox {
							width: 100%;
							height: 32px;
							choices: ["Standard", "Custom"];
							value: "Standard";
							enabled: false;
						}
					}
					
					// Win by 2 filter
					StylizedCheckbox {
						text: "Win by 2";
						checked: false;
					}
					
					// Negative Scores filter
					StylizedCheckbox {
						text: "Negative Scores";
						checked: false;
					}
					
					// Dealer Override filter
					StylizedCheckbox {
						text: "Dealer Override";
						checked: false;
					}
					
					// Max Score filter
					VerticalLayout {
						spacing: 10px;
						
						StylizedCheckbox {
							text: "Max Score";
							checked: false;
						}
						
						HorizontalLayout {
							spacing: 10px;
							
							StylizedComboBox {
								width: 40%;
								height: 32px;
								choices: ["=", "≤", "≥", "<", ">", "≠"];
								value: "=";
								enabled: false;
							}
							
							StylizedSpinBox {
								width: 60%;
								value: 11;
								minimum: 1;
								maximum: 99;
								enabled: false;
							}
						}
					}
					
					// Max Players filter
					VerticalLayout {
						spacing: 10px;
						
						StylizedCheckbox {
							text: "Max Players";
							checked: false;
						}
						
						HorizontalLayout {
							spacing: 10px;
							
							StylizedComboBox {
								width: 40%;
								height: 32px;
								choices: ["=", "≤", "≥", "<", ">", "≠"];
								value: "=";
								enabled: false;
							}
							
							StylizedSpinBox {
								width: 60%;
								value: 4;
								minimum: 2;
								maximum: 8;
								enabled: false;
							}
						}
					}
					
					// Refresh button
					StylizedButton {
						text: "Refresh";
						font-size: 24px;
						clicked => {
							GameState.fetch-games();
						}
					}
				}
			}
		}
	}

	//Game
	if GameState.scene == SceneType.Game : Rectangle {
		width: 100%;
		height: 100%;
		background: Palette.Green;
		
		// Settings button
		Rectangle {
			width: 48px;
			height: 48px;
			x: 25px;
			y: 25px;
			
			Image {
				source: @image-url("../assets/images/gear.png");
				width: parent.width;
				height: parent.height;
			}
			
			gameTouchArea := TouchArea {
				clicked => {
					darkScreenGame.visible = true;
					gameMenu.show();
				}
			}
			
			states [
				hover when gameTouchArea.has-hover: {
					gameTouchArea.mouse-cursor: pointer;
				}
			]
		}
		
		// Game information display
		HorizontalLayout {
			y: 25px;
			padding-left: 100px;
			padding-right: 100px;
			spacing: 40px;
			
			// Round number
			Rectangle {
				width: 150px;
				height: 48px;
				background: #18181840;
				border-radius: 8px;
				
				BaseText {
					text: "Round 1"; // TODO: Get from game state
					font-size: 24px;
					horizontal-alignment: center;
					vertical-alignment: center;
				}
			}
			
			// Team scores
			Rectangle {
				width: 300px;
				height: 48px;
				background: #18181840;
				border-radius: 8px;
				
				HorizontalLayout {
					padding: 10px;
					spacing: 20px;
					
					BaseText {
						text: "Team 1: 0"; // TODO: Get from game state
						font-size: 24px;
						vertical-alignment: center;
					}
					
					BaseText {
						text: "Team 2: 0"; // TODO: Get from game state
						font-size: 24px;
						vertical-alignment: center;
					}
				}
			}
			
			// Trump suit
			Rectangle {
				width: 150px;
				height: 48px;
				background: #18181840;
				border-radius: 8px;
				
				HorizontalLayout {
					padding: 10px;
					spacing: 10px;
					
					BaseText {
						text: "Trump:";
						font-size: 24px;
						vertical-alignment: center;
					}
					
					Image {
						width: 24px;
						height: 24px;
						source: @image-url("../assets/images/suits/hearts.png"); // TODO: Get from game state
						y: (parent.height - self.height) / 2;
					}
				}
			}
			
			// Lead suit
			Rectangle {
				width: 150px;
				height: 48px;
				background: #18181840;
				border-radius: 8px;
				
				HorizontalLayout {
					padding: 10px;
					spacing: 10px;
					
					BaseText {
						text: "Lead:";
						font-size: 24px;
						vertical-alignment: center;
					}
					
					Image {
						width: 24px;
						height: 24px;
						source: @image-url("../assets/images/suits/clubs.png"); // TODO: Get from game state
						y: (parent.height - self.height) / 2;
					}
				}
			}
			
			// Highest bid
			Rectangle {
				width: 150px;
				height: 48px;
				background: #18181840;
				border-radius: 8px;
				
				BaseText {
					text: "Bid: 3"; // TODO: Get from game state
					font-size: 24px;
					horizontal-alignment: center;
					vertical-alignment: center;
				}
			}
		}
		
		// Player arrangement and game area
		Rectangle {
			y: 100px;
			width: parent.width;
			height: parent.height - 100px;
			
			// Other players
			for player[i] in GameState.players : PlayerDisplay {
				visible: !player.local;
				property <{x: length, y: length}> pos: GameState.calc_player_pos(i);
				x: pos.x + (parent.width - self.width) / 2;
				y: pos.y + (parent.height - self.height) / 2;
				
				username: player.username;
				is-human: player.player_type == PlayerType.Human;
				team: player.team;
				is-local: player.local;
				is-ready: false;
				is-current-turn: false; // TODO: Get from game state
				is-setup-mode: false;
				can-edit: false;
				size: 150px;
			}
			
			// Center pile
			Rectangle {
				x: (parent.width - self.width) / 2;
				y: (parent.height - self.height) / 2;
				width: 140px;
				height: 200px;
				
				// Last played card
				Card {
					number: 10; // TODO: Get from game state
					suit: 0; // TODO: Get from game state
					face-up: true;
					enabled: false;
					width: parent.width;
				}
				
				// Pile owner label
				BaseText {
					text: "Player 2's Pile"; // TODO: Get from game state
					font-size: 20px;
					horizontal-alignment: center;
					y: parent.height + 10px;
				}
			}
			
			// Deck
			Rectangle {
				x: parent.width - self.width - 100px;
				y: (parent.height - self.height) / 2;
				width: 140px;
				height: 200px;
				
				Card {
					face-up: false;
					enabled: false;
					width: parent.width;
				}
				
				BaseText {
					text: "Deck";
					font-size: 20px;
					horizontal-alignment: center;
					y: parent.height + 10px;
				}
			}
			
			// Local player's hand
			Rectangle {
				x: (parent.width - self.width) / 2;
				y: parent.height - self.height - 50px;
				width: 600px;
				height: 200px;
				
				HorizontalLayout {
					spacing: -50px;
					
					for card[i] in [
						{number: 2, suit: 0},
						{number: 7, suit: 1},
						{number: 10, suit: 2},
						{number: 14, suit: 3},
						{number: 11, suit: 0},
						{number: 4, suit: 2}
					] : Card {
						number: card.number;
						suit: card.suit;
						face-up: true;
						enabled: true;
						draggable: true;
						width: 140px;
						
						clicked => {
							// TODO: Handle card click
						}
						
						drag-started => {
							// TODO: Handle drag start
						}
						
						drag-ended => {
							// TODO: Handle drag end
						}
					}
				}
			}
		}
		
		// Bid prompt overlay
		Rectangle {
			visible: false; // TODO: Show when bidding
			background: #00000080;
			width: 100%;
			height: 100%;
			
			VerticalLayout {
				padding: 200px;
				spacing: 40px;
				
				BaseText {
					text: "Make Your Bid";
					font-size: 48px;
					horizontal-alignment: center;
				}
				
				HorizontalLayout {
					alignment: center;
					spacing: 20px;
					
					for bid in [0, 2, 3, 4, 5] : StylizedButton {
						text: bid == 0 ? "Pass" : bid;
						width: 100px;
						height: 60px;
						font-size: 32px;
						enabled: bid == 0 || bid > 3; // TODO: Check against highest bid
						clicked => {
							GameState.bid(bid);
						}
					}
				}
			}
		}
		
		// Round summary overlay
		Rectangle {
			visible: false; // TODO: Show at end of round
			background: #00000080;
			width: 100%;
			height: 100%;
			
			Rectangle {
				width: 600px;
				height: 400px;
				background: Palette.Green;
				border-radius: 16px;
				border-width: 2px;
				border-color: Palette.Gray;
				
				VerticalLayout {
					padding: 40px;
					spacing: 20px;
					
					BaseText {
						text: "Round Summary";
						font-size: 32px;
						horizontal-alignment: center;
					}
					
					for score in [
						{type: "High", team: 1},
						{type: "Low", team: 2},
						{type: "Jack", team: 1},
						{type: "Game", points: 3, team: 2}
					] : BaseText {
						text: score.type + (score.type == "Game" ? 
							" (" + score.points + " points)" : "") + 
							" - Team " + score.team;
						font-size: 24px;
						horizontal-alignment: center;
					}
					
					StylizedButton {
						text: "Continue";
						width: 200px;
						height: 50px;
						font-size: 24px;
						clicked => {
							// TODO: Hide summary
						}
					}
				}
			}
		}
		
		// Game menu overlay
		darkScreenGame := DarkScreen {
			visible: false;
		}
		
		gameMenu := PopupWindow {
			width: 400px;
			height: 500px;
			x: (parent.width - self.width) / 2;
			y: (parent.height - self.height) / 2;
			close-policy: close-on-click-outside;

			Rectangle {
				background: Palette.Green;
				border-radius: 16px;
				border-width: 2px;
				border-color: Palette.Gray;

				VerticalLayout {
					padding: 40px;
					spacing: 20px;

					StylizedButton {
						text: "Settings";
						font-size: 24px;
						clicked => {
							settings-popup.show();
						}
					}
					
					StylizedButton {
						text: "Leave Game";
						font-size: 24px;
						clicked => {
							leave-game-dialog.visible = true;
						}
					}
					
					StylizedButton {
						text: "Resume";
						font-size: 24px;
						clicked => {
							darkScreenGame.visible = false;
							gameMenu.close();
						}
					}
				}
			}
		}
		
		// Settings popup
		settings-popup := PopupWindow {
			x: (parent.width - 800px) / 2;
			y: (parent.height - 600px) / 2;
			width: 800px;
			height: 600px;
			close-policy: close-on-click-outside;

			Rectangle {
				background: Palette.Green;
				border-radius: 16px;
				border-width: 2px;
				border-color: Palette.Gray;

				Settings {
					show-back-button: true;
					back => {
						settings-popup.close();
					}
				}
			}
		}

		// Leave game confirmation dialog
		leave-game-dialog := ConfirmationDialog {
			message: "Are you sure you want to leave the game?";
			
			confirmed => {
				GameState.scene = SceneType.MainMenu;
				GameState.host = HostType.None;
				darkScreenGame.visible = false;
				gameMenu.close();
			}
		}
	}

	//Settings
	if GameState.scene == SceneType.Settings : Rectangle {
		width: 100%;
		height: 100%;
		background: Palette.Green;

		StylizedButton {
			text: "Back";
			width: 150px;
			height: 50px;
			x: 25px;
			y: 25px;
			font-size: 24px;
			clicked => {
				GameState.scene = SceneType.MainMenu;
			}
		}

		Rectangle {
			width: 100%;
			height: 90%;
			y: 100px;
			
			Settings {
				width: 100%;
				height: 100%;
			}
		}
	}
}