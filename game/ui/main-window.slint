component BackButton inherits MenuButton {
	in property <SceneType> goto_scene;

	clicked => {GameState.scene = self.goto_scene;}

	label: "Back";
	fontScale: 4;
	width: 150px;
	height: 65px;
	x: 25px;
	y: 25px;
}

component DarkScreen inherits Rectangle {
	visible: false;
    background: #00000080;
    width: 100%;
    height: 100%;
}

export component MainWindow inherits Window {
	width: 1920px;
	height: 1080px;
	title: "Setback";
	icon: @image-url("../assets/images/cardsIcon.png");

	//Main Menu
	if GameState.scene == SceneType.MainMenu : Rectangle {
		width: 100%;
		height: 100%;
		background: Palette.Green;

		Text {
			text: "Setback";
			font-size: 200px;
			font-weight: 900;
			color: Palette.Orange;
			stroke: Palette.Gray;
			stroke-width: 10px;
			horizontal-alignment: center;
			y: 40px;
		}

		VerticalLayout {
			y: 100px;
			spacing: 40px;
			alignment: center;
			width: 450px;

			singleplayer := MenuButton {
				label: "Play";//TODO change to "Singleplayer" when multiplayer is added
				fontScale: 7;
				clicked => {
					GameState.scene = SceneType.Setup;
					GameState.host = HostType.SingleplayerSetup;
				}
			}

//			multiplayer := MenuButton {
//				label: "Multiplayer";
//				fontScale: 7;
//				clicked => {
//					darkScreenMainMenu.visible = true;
//					multiplayerPopup.visible = true;
//					options.visible = true;
//					create.visible = false;
//					join.visible = false;
//				}
//			}

			settings := MenuButton {
				label: "Settings";
				fontScale: 7;
				clicked => {GameState.scene = SceneType.Settings;}
			}

			exit := MenuButton {
				label: "Exit";
				fontScale: 7;
				clicked => {GameState.exit();}
			}
		}

		darkScreenMainMenu := DarkScreen {}

		multiplayerPopup := Rectangle {
			visible: false;
			y: 300px;
			width: 500px;
			height: 600px;
			background: Palette.Green;
			border-color: Palette.Gray;
			border-width: 10px;

			options := VerticalLayout {
				spacing: 80px;
				alignment: center;
				width: 450px;

				MenuButton {
					label: "Create Game";
					fontScale: 5;
					clicked => {
						options.visible = false;
						singleplayer.enabled = false;
//						multiplayer.enabled = false;//TODO enable with multiplayer
						settings.enabled = false;
						exit.enabled = false;
						GameState.scene = SceneType.Setup;
						GameState.host = HostType.Host;
					}
				}

				MenuButton {
					label: "Join With Code";
					fontScale: 5;
					clicked => {
						options.visible = false;
						join.visible = true;
						singleplayer.enabled = false;
//                        multiplayer.enabled = false;//TODO enable with multiplayer
                        settings.enabled = false;
                        exit.enabled = false;
					}
				}

				MenuButton {
                    label: "Search Games";
                    fontScale: 5;
                    clicked => {
                        GameState.scene = SceneType.Multiplayer;
                        //TODO fetch public multiplayer games
                    }
                }

				MenuButton {
					label: "Close";
					fontScale: 5;
					clicked => {
						darkScreenMainMenu.visible = false;
						multiplayerPopup.visible = false;
						singleplayer.enabled = true;
//                        multiplayer.enabled = true;//TODO enable with multiplayer
                        settings.enabled = true;
                        exit.enabled = true;
					}
				}
			}

			join := VerticalLayout {
				visible: false;
				spacing: 80px;
				alignment: center;

				states [
					focus when input.has-focus && input.text != "": {
						preview.visible: false;
					}
					notFocus when !input.has-focus || input.text == "": {
						preview.visible: true;
					}
				]

				Rectangle {
					width: 400px;
					height: 80px;
					x: 50px;
					border-width: 5px;
					border-color: Palette.Gray;
					background: white.darker(0.1);

					preview := Text {
						text: "Enter game code...";
						font-size: 30px;
						font-weight: 900;
						stroke: Palette.Gray;
						stroke-width: 3px;
						color: Palette.Orange.darker(0.1);
						vertical-alignment: center;
						x: 15px;
					}

					input := TextInput {
						horizontal-alignment: center;
						vertical-alignment: center;
						font-size: 40px;
						font-weight: 900;
						color: Palette.Orange;

						edited => {
							//TODO don't allow the user to enter too many characters
						}
					}
				}

				MenuButton {
					label: "Join";
					fontScale: 5;
					clicked => {
						GameState.send_join(input.text);//TODO does this function need to return anything?
						darkScreenMainMenu.visible = false;
                        multiplayerPopup.visible = false;
                        singleplayer.enabled = true;
//                        multiplayer.enabled = true;//TODO enable with multiplayer
                        settings.enabled = true;
                        exit.enabled = true;
						options.visible = false;
                        exit.enabled = false;
						GameState.host = HostType.Client;
					}
				}

				MenuButton {
					label: "Back";
					fontScale: 5;
					clicked => {
						join.visible = false;
						options.visible = true;
					}
				}
			}
		}
	}

	//Setup
	if GameState.scene == SceneType.Setup : Rectangle {
		width: 100%;
		height: 100%;
		background: Palette.Green;

		BackButton {
            goto_scene: SceneType.MainMenu;
        }

        MenuButton {
            label: "Start";//TODO make it say "Ready" when in multiplayer
            fontScale: 10;
            width: 340px;
            height: 125px;
            x: parent.width - self.width - 25px;
            y: parent.height - self.height - 25px;

            clicked => {
                //TODO start game for singleplayer - start countdown for multiplayer
            }
        }

        Rectangle {
			background: #00000080;
			width: 500px;
			height: 550px;
			x: parent.width - self.width - 25px;
			y: 25px;

			VerticalLayout {
				alignment: center;
				spacing: 25px;
				padding: 25px;

				//TODO hovering over the label should show a PopupWindow with a description of the setting
				//Or there should be an information icon like (i)

				CheckBox {
					checked: true;
					text: "Standard Teams";
					scale: 3;
				}
				CheckBox {
					checked: false;
					text: "Win By 2";
					scale: 3;
				}
				CheckBox {
	                checked: true;
	                text: "Negative Scores";
	                scale: 3;
	            }
				CheckBox {
	                checked: false;
	                text: "Dealer Override 4 Bid";
	                scale: 3;
	            }
	            VerticalLayout {
	                in-out property <float> max_score <=> slider.value;//we have to do this because Slider.step is broken
