import {Palette} from "global.slint";
import {BaseText} from "base_text.slint";

// Tab view component for settings
export component StylizedTabView {
	in property <[string]> tabs;
	in-out property <int> active-tab: 0;
	function tab-changed(index: int) {
		root.active-tab = index;
	}

	VerticalLayout {
		// Tab headers
		HorizontalLayout {
			height: 40px;
			spacing: 2px;

			for tab[index] in tabs : Rectangle {
				width: 120px;
				background: index == active-tab ? #18181880 : #18181840;
				border-width: 2px;
				border-color: index == active-tab ? Palette.Orange : Palette.Orange.darker(0.3);
				border-radius: 8px;

				BaseText {
					text: tab;
					font-size: 16px;
					horizontal-alignment: center;
					vertical-alignment: center;
				}

				touchArea := TouchArea {
					clicked => {
						root.tab-changed(index);
					}

					mouse-cursor: pointer;
				}

				states [
					hover when index != active-tab && touchArea.has-hover: {
						background: #18181860;
					}
				]
			}
		}

		// Content area
		Rectangle {
			background: #18181880;
			border-width: 2px;
			border-color: Palette.Orange;
			border-radius: 8px;

			@children
		}
	}
}