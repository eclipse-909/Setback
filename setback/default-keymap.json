[
	{
		"context": "in_game",
		"bindings": {
			"escape": "game::toggle_menu"
		}
	},
	{
		"context": "in_game && my_turn && bidding",
		"bindings": {
			"0": "game::bid_pass",
			"p": "game::bid_pass",
			"2": "game::bid_2",
			"3": "game::bid_3",
			"4": "game::bid_4"
		}
	},
	{
		"context": "in_game && my_turn && bidding && dealer_override",
		"bindings": {
			"4": "game::bid_4_override",
			"5": "game::bid_4_override",
			"o": "game::bid_4_override"
		}
	},
	{
		"context": "in_game && my_turn && playing",
		"bindings": {
			"1": "game::play_card_1",
			"2": "game::play_card_2",
			"3": "game::play_card_3",
			"4": "game::play_card_4",
			"5": "game::play_card_5",
			"6": "game::play_card_6"
		}
	}
]